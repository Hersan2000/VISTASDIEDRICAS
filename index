        /* =========================================================================
         * GUARDADO Y CARGA CIFRADA DE EVALUACIÓN (.sav con AES-GCM 256-bit)
         * ========================================================================= */
        async function deriveSavKey(saltBytes) {
            const enc = new TextEncoder();
            const baseKey = await window.crypto.subtle.importKey(
                'raw',
                enc.encode(SAV_SECRET),
                { name: 'PBKDF2' },
                false,
                ['deriveKey']
            );
            return window.crypto.subtle.deriveKey(
                {
                    name: 'PBKDF2',
                    salt: saltBytes,
                    iterations: 100000,
                    hash: 'SHA-256'
                },
                baseKey,
                { name: 'AES-GCM', length: 256 },
                false,
                ['encrypt', 'decrypt']
            );
        }

        async function encryptSavPayload(payloadObj) {
            const enc = new TextEncoder();
            const magicBytes = enc.encode(SAV_MAGIC); // 8 bytes
            const salt = window.crypto.getRandomValues(new Uint8Array(16));
            const iv = window.crypto.getRandomValues(new Uint8Array(12));
            const key = await deriveSavKey(salt);
            const plainBytes = enc.encode(JSON.stringify(payloadObj));

            const cipherBuffer = await window.crypto.subtle.encrypt(
                { name: 'AES-GCM', iv },
                key,
                plainBytes
            );
            const cipherBytes = new Uint8Array(cipherBuffer);

            const out = new Uint8Array(magicBytes.length + salt.length + iv.length + cipherBytes.length);
            out.set(magicBytes, 0);
            out.set(salt, magicBytes.length);
            out.set(iv, magicBytes.length + salt.length);
            out.set(cipherBytes, magicBytes.length + salt.length + iv.length);
            return out.buffer;
        }

        async function decryptSavBuffer(arrayBuffer) {
            const bytes = new Uint8Array(arrayBuffer);
            if (bytes.length < 44) {
                throw new Error('Archivo .sav demasiado corto o inválido.');
            }
            const dec = new TextDecoder();
            const magic = dec.decode(bytes.slice(0, 8));
            if (magic !== SAV_MAGIC) {
                throw new Error('Formato de archivo no reconocido como .sav válido.');
            }

            const salt = bytes.slice(8, 24);
            const iv = bytes.slice(24, 36);
            const cipherBytes = bytes.slice(36);
            const key = await deriveSavKey(salt);

            let plainBuffer;
            try {
                plainBuffer = await window.crypto.subtle.decrypt(
                    { name: 'AES-GCM', iv },
                    key,
                    cipherBytes
                );
            } catch (e) {
                throw new Error('El archivo .sav está dañado o ha sido alterado y no puede descifrarse.');
            }

            const jsonStr = dec.decode(plainBuffer);
            return JSON.parse(jsonStr);
        }

