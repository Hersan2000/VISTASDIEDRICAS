<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Taller de Vistas Diédricas 3D — Aprendizaje y Evaluación</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- jsPDF para generación de diplomas y certificados en PDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <!-- Fuente Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Importmap para Three.js moderno (v0.160.0) desde jsDelivr -->
    <script type="importmap">
    {
        "imports": {
            "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
            "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"
        }
    }
    </script>

    <style>
        html, body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: #f1f5f9;
            color: #0f172a;
            height: 100vh;
            height: 100dvh;
            width: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
            -webkit-tap-highlight-color: transparent;
        }

        .no-select {
            user-select: none;
            -webkit-user-select: none;
        }

        /* Fondo sutil de mesa de dibujo técnico */
        .drafting-bg {
            background-color: #f8fafc;
            background-image:
                linear-gradient(to right, rgba(203, 213, 225, 0.35) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(203, 213, 225, 0.35) 1px, transparent 1px);
            background-size: 20px 20px;
        }

        /* Estilos de líneas SVG */
        .seg-line {
            pointer-events: none;
            stroke-linecap: round;
            transition: stroke 0.14s ease, stroke-width 0.14s ease;
        }

        .seg-solid {
            stroke: #0f172a;
            stroke-width: 4.5;
        }

        .seg-dashed {
            stroke: #334155;
            stroke-width: 3.4;
            stroke-dasharray: 8 6;
            stroke-linecap: butt;
        }

        /* Corrección / verificación */
        .seg-check-ok {
            stroke: #16a34a !important;
        }

        .seg-check-wrong {
            stroke: #dc2626 !important;
        }

        .seg-check-missing {
            stroke: #f59e0b;
            stroke-width: 3.8;
            stroke-linecap: round;
            opacity: 0.92;
            pointer-events: none;
        }

        /* Solución superpuesta (solo en modo Práctica) */
        .seg-solution-solid {
            stroke: #2563eb;
            stroke-width: 4.5;
            stroke-linecap: round;
            opacity: 0.72;
            pointer-events: none;
        }

        .seg-solution-dashed {
            stroke: #2563eb;
            stroke-width: 3.4;
            stroke-dasharray: 8 6;
            stroke-linecap: butt;
            opacity: 0.72;
            pointer-events: none;
        }

        /* Contenedor canvas 3D con soporte táctil */
        #viewport-3d canvas {
            display: block;
            width: 100% !important;
            height: 100% !important;
            outline: none;
            touch-action: none;
        }

        /* SVG interactivo sin scroll accidental */
        .draft-svg {
            touch-action: none;
            cursor: crosshair;
        }

        /* Botón activo de herramienta */
        .tool-btn.active {
            background-color: #1e293b;
            color: #ffffff;
            border-color: #0f172a;
            box-shadow: 0 2px 6px rgba(15, 23, 42, 0.18);
        }

        .tool-btn.active svg {
            color: #ffffff;
        }

        /* Pestaña de modo activa */
        .mode-tab.active {
            background-color: #ffffff;
            color: #1d4ed8;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.12);
        }

        /* Nivel de evaluación activo */
        .eval-tab.active {
            background-color: #1e293b;
            color: #ffffff;
            border-color: #0f172a;
        }

        /* Animación suave de modales */
        @keyframes modalPop {
            from { opacity: 0; transform: scale(0.95) translateY(8px); }
            to   { opacity: 1; transform: scale(1) translateY(0); }
        }
        .modal-card {
            animation: modalPop 0.2s ease-out forwards;
        }
    </style>
</head>
<body class="h-full flex flex-col overflow-hidden no-select">

    <!-- ===================================================================== -->
    <!-- MODAL DE BIENVENIDA / INICIO DE SESIÓN OBLIGATORIO                    -->
    <!-- ===================================================================== -->
    <div id="login-modal" class="fixed inset-0 z-50 bg-slate-900/65 backdrop-blur-sm flex items-center justify-center p-4 hidden">
        <div class="modal-card bg-white rounded-3xl shadow-2xl border border-slate-200 max-w-md w-full p-6 sm:p-8">
            <div class="flex flex-col items-center text-center mb-6">
                <div class="w-14 h-14 rounded-2xl bg-blue-600 text-white flex items-center justify-center shadow-md mb-4">
                    <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                        <line x1="12" y1="22.08" x2="12" y2="12"/>
                    </svg>
                </div>
                <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900">Taller de Vistas Diédricas 3D</h1>
                <p class="text-sm text-slate-500 mt-1.5 leading-relaxed">
                    Sistema Europeo · Plataforma de Aprendizaje y Evaluación con cubos y rampas 3×3×3.
                </p>
            </div>

            <form id="login-form" class="space-y-4">
                <div>
                    <label for="student-name-input" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
                        Nombre completo del alumno/a
                    </label>
                    <input
                        id="student-name-input"
                        type="text"
                        maxlength="60"
                        autocomplete="name"
                        placeholder="Ej. Laura Martínez Gómez"
                        class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-slate-50 focus:bg-white focus:border-blue-600 focus:ring-2 focus:ring-blue-500/20 outline-none text-slate-900 font-medium text-sm sm:text-base transition select-text"
                        required
                    >
                    <p id="login-error" class="text-xs text-rose-600 font-medium mt-1.5 hidden">
                        Por favor, introduce tu nombre completo para comenzar.
                    </p>
                </div>

                <div class="bg-blue-50/80 border border-blue-100 rounded-xl p-3 text-xs text-blue-900/85 space-y-1">
                    <p><strong>• Guardado automático:</strong> tu avance y tus diplomas se guardan automáticamente en este dispositivo.</p>
                    <p><strong>• Nombre bloqueado:</strong> aparecerá en tus certificados PDF y solo podrá cambiarse cerrando sesión.</p>
                </div>

                <button type="submit" class="w-full py-3.5 px-4 rounded-xl bg-blue-600 hover:bg-blue-700 active:scale-[0.99] text-white font-bold text-sm sm:text-base shadow-md transition cursor-pointer">
                    Comenzar sesión
                </button>
            </form>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- MODAL GENÉRICO DE CONFIRMACIÓN (SIN alert/confirm NATIVOS)            -->
    <!-- ===================================================================== -->
    <div id="confirm-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 hidden">
        <div class="modal-card bg-white rounded-2xl shadow-2xl border border-slate-200 max-w-sm w-full p-6">
            <h3 id="confirm-title" class="text-lg font-bold text-slate-900 mb-2">Confirmar acción</h3>
            <p id="confirm-message" class="text-sm text-slate-600 leading-relaxed mb-5"></p>
            <div class="flex items-center justify-end gap-2.5">
                <button id="confirm-cancel" class="px-4 py-2.5 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-sm font-semibold transition cursor-pointer">
                    Cancelar
                </button>
                <button id="confirm-ok" class="px-4 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-sm font-semibold shadow-sm transition cursor-pointer">
                    Confirmar
                </button>
            </div>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- MODAL DE ENHORABUENA AL COMPLETAR EVALUACIÓN (10/10)                  -->
    <!-- ===================================================================== -->
    <div id="congrats-modal" class="fixed inset-0 z-50 bg-slate-900/65 backdrop-blur-sm flex items-center justify-center p-4 hidden">
        <div class="modal-card bg-white rounded-3xl shadow-2xl border border-amber-200 max-w-md w-full p-6 sm:p-8 text-center">
            <div class="w-16 h-16 mx-auto rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center mb-4 shadow-inner">
                <svg class="w-9 h-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="8" r="6"></circle>
                    <path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"></path>
                </svg>
            </div>
            <span class="inline-block px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold uppercase tracking-wider mb-2">
                ¡Nivel Superado · 10 / 10!
            </span>
            <h2 class="text-2xl font-extrabold text-slate-900">¡Enhorabuena, <span id="congrats-name"></span>!</h2>
            <p class="text-sm text-slate-600 mt-2 leading-relaxed">
                Has completado correctamente las 10 figuras del nivel <strong id="congrats-level" class="text-slate-900"></strong>. Ya puedes descargar tu Diploma Oficial en PDF con todas tus piezas y vistas resueltas.
            </p>
            <div class="mt-6 flex flex-col gap-2.5">
                <button id="btn-congrats-pdf" class="w-full py-3.5 px-4 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-bold text-sm shadow-md transition cursor-pointer flex items-center justify-center gap-2">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    <span>Descargar Diploma Oficial (PDF)</span>
                </button>
                <button id="btn-congrats-close" class="w-full py-2.5 px-4 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-sm transition cursor-pointer">
                    Cerrar
                </button>
            </div>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- BARRA SUPERIOR DE NAVEGACIÓN Y USUARIO                                -->
    <!-- ===================================================================== -->
    <header class="bg-white border-b border-slate-200 shrink-0 z-30 shadow-sm">
        <div class="max-w-[1640px] mx-auto px-3 sm:px-4 py-1.5 flex flex-wrap items-center justify-between gap-2">
            <!-- Marca -->
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-blue-600 text-white flex items-center justify-center shadow-sm shrink-0">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                        <line x1="12" y1="22.08" x2="12" y2="12"/>
                    </svg>
                </div>
                <div class="leading-tight">
                    <h1 class="text-sm sm:text-base font-extrabold text-slate-900">Vistas Diédricas 3D</h1>
                    <p class="text-[11px] text-slate-500 hidden md:block">Sistema Europeo · Cubos y Rampas 3×3×3</p>
                </div>
            </div>

            <!-- Selector de Modo: PRÁCTICA | EVALUACIÓN -->
            <nav class="flex items-center bg-slate-100 p-1 rounded-xl border border-slate-200/80" aria-label="Modo de trabajo">
                <button id="tab-practice" class="mode-tab active px-3.5 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-bold text-slate-600 transition cursor-pointer flex items-center gap-1.5">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                    </svg>
                    <span>Práctica</span>
                </button>
                <button id="tab-eval" class="mode-tab px-3.5 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-bold text-slate-600 transition cursor-pointer flex items-center gap-1.5">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    <span>Evaluación</span>
                </button>
            </nav>

            <!-- Perfil del Alumno (bloqueado) y Cerrar Sesión -->
            <div class="flex items-center gap-2 ml-auto sm:ml-0">
                <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-100 border border-slate-200 text-slate-800 max-w-[170px] sm:max-w-[230px]" title="Nombre del alumno activo (bloqueado durante la sesión)">
                    <span class="w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold flex items-center justify-center shrink-0" id="header-user-avatar">A</span>
                    <span id="header-user-name" class="text-xs sm:text-sm font-semibold truncate">Alumno</span>
                </div>
                <button id="btn-logout" title="Cerrar sesión y cambiar de alumno" class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-xl border border-slate-300 bg-white hover:bg-rose-50 hover:border-rose-200 hover:text-rose-700 text-slate-600 text-xs font-semibold transition cursor-pointer">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    <span class="hidden sm:inline">Cerrar sesión</span>
                </button>
            </div>
        </div>

        <!-- SUB-BARRA CONTEXTUAL: CONTROLES DE PRÁCTICA -->
        <div id="bar-practice" class="bg-slate-50/90 border-t border-slate-200/80">
            <div class="max-w-[1640px] mx-auto px-3 sm:px-4 py-1.5 flex flex-wrap items-center justify-between gap-2">
                <!-- Selector de 5 dificultades -->
                <div class="flex flex-wrap items-center gap-1.5">
                    <span class="text-xs font-bold text-slate-500 uppercase tracking-wider mr-1 hidden sm:inline">Dificultad:</span>
                    <select id="practice-diff-select" class="px-3 py-1.5 rounded-xl border border-slate-300 bg-white text-slate-800 text-xs sm:text-sm font-semibold shadow-sm focus:border-blue-500 outline-none cursor-pointer">
                        <option value="muy_facil">1 · Muy fácil (sin rampas)</option>
                        <option value="facil">2 · Fácil</option>
                        <option value="medio" selected>3 · Medio</option>
                        <option value="dificil">4 · Difícil</option>
                        <option value="muy_dificil">5 · Muy difícil</option>
                    </select>
                </div>

                <!-- Acciones de práctica -->
                <div class="flex flex-wrap items-center gap-2">
                    <button id="btn-new-figure" class="inline-flex items-center gap-1.5 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl bg-blue-600 hover:bg-blue-700 active:scale-[0.98] text-white text-xs sm:text-sm font-semibold shadow-sm transition cursor-pointer">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="23 4 23 10 17 10"></polyline>
                            <polyline points="1 20 1 14 7 14"></polyline>
                            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                        </svg>
                        <span>Nueva figura</span>
                    </button>

                    <button id="btn-check-practice" class="inline-flex items-center gap-1.5 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-[0.98] text-white text-xs sm:text-sm font-semibold shadow-sm transition cursor-pointer">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>Comprobar</span>
                    </button>

                    <button id="btn-solution" class="inline-flex items-center gap-1.5 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl bg-white hover:bg-slate-100 active:scale-[0.98] text-slate-700 border border-slate-300 text-xs sm:text-sm font-semibold shadow-sm transition cursor-pointer">
                        <svg class="w-4 h-4 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                        <span id="btn-solution-text">Ver solución</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- SUB-BARRA CONTEXTUAL: CONTROLES DE EVALUACIÓN -->
        <div id="bar-eval" class="bg-slate-50/95 border-t border-slate-200/80 hidden">
            <div class="max-w-[1640px] mx-auto px-3 sm:px-4 py-1.5 space-y-1.5">
                <!-- Fila 1: Selector de nivel + Acciones PDF + Reiniciar -->
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <div class="flex flex-wrap items-center gap-1.5">
                        <button data-eval-level="basico" class="eval-tab active px-3 py-1.5 rounded-xl border border-slate-300 bg-white text-slate-700 text-xs font-bold transition cursor-pointer flex items-center gap-1.5">
                            <span>Básico</span>
                            <span id="badge-eval-basico" class="px-1.5 py-0.5 rounded-md bg-slate-200/80 text-slate-800 text-[10px]">0/10</span>
                        </button>
                        <button data-eval-level="intermedio" class="eval-tab px-3 py-1.5 rounded-xl border border-slate-300 bg-white text-slate-700 text-xs font-bold transition cursor-pointer flex items-center gap-1.5">
                            <span>Intermedio</span>
                            <span id="badge-eval-intermedio" class="px-1.5 py-0.5 rounded-md bg-slate-200/80 text-slate-800 text-[10px]">0/10</span>
                        </button>
                        <button data-eval-level="avanzado" class="eval-tab px-3 py-1.5 rounded-xl border border-slate-300 bg-white text-slate-700 text-xs font-bold transition cursor-pointer flex items-center gap-1.5">
                            <span>Avanzado</span>
                            <span id="badge-eval-avanzado" class="px-1.5 py-0.5 rounded-md bg-slate-200/80 text-slate-800 text-[10px]">0/10</span>
                        </button>
                    </div>

                    <div class="flex flex-wrap items-center gap-2">
                        <!-- Botón Diploma Oficial (visible al completar 10/10) -->
                        <button id="btn-pdf-official" class="hidden inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-xs sm:text-sm font-bold shadow-sm transition cursor-pointer animate-pulse">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="8" r="6"></circle>
                                <path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"></path>
                            </svg>
                            <span>Descargar Diploma Oficial (PDF)</span>
                        </button>

                        <!-- Botón Diploma de Avance (siempre disponible) -->
                        <button id="btn-pdf-progress" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold shadow-sm transition cursor-pointer">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                                <line x1="12" y1="18" x2="12" y2="12"></line>
                                <polyline points="9 15 12 18 15 15"></polyline>
                            </svg>
                            <span>Diploma de avance (PDF)</span>
                        </button>

                        <button id="btn-reset-eval" title="Reiniciar este nivel de evaluación" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl border border-slate-300 bg-white hover:bg-rose-50 hover:text-rose-700 hover:border-rose-200 text-slate-600 text-xs font-semibold transition cursor-pointer">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="1 4 1 10 7 10"></polyline>
                                <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                            </svg>
                            <span class="hidden sm:inline">Reiniciar</span>
                        </button>
                    </div>
                </div>

                <!-- Fila 2: Progreso 1..10 + Comprobar + Siguiente figura -->
                <div class="flex flex-wrap items-center justify-between gap-2 bg-white rounded-xl border border-slate-200 px-3 py-1.5">
                    <div class="flex flex-wrap items-center gap-3 flex-1 min-w-[220px]">
                        <div>
                            <div class="text-xs sm:text-sm font-bold text-slate-900" id="eval-figure-label">Figura 1 de 10 · Muy fácil</div>
                            <div class="w-40 sm:w-48 h-1.5 bg-slate-100 rounded-full overflow-hidden mt-1">
                                <div id="eval-progress-bar" class="h-full bg-emerald-500 transition-all duration-300" style="width: 0%"></div>
                            </div>
                        </div>
                        <!-- Mini indicadores 1..10 -->
                        <div id="eval-step-pills" class="flex flex-wrap items-center gap-1"></div>
                    </div>

