        /* =========================================================================
         * GENERACIÓN DE DIPLOMAS Y CERTIFICADOS EN PDF RASTERIZADOS (ANTI-FRAUDE)
         * ========================================================================= */
        function drawAntiForgeryBackground(ctx, w, h) {
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, w, h);

            // Patrón procedural de líneas aleatorias en gris muy claro
            ctx.save();
            for (let i = 0; i < 420; i++) {
                const x1 = Math.random() * w;
                const y1 = Math.random() * h;
                const angle = Math.random() * Math.PI * 2;
                const len = 70 + Math.random() * 260;
                const x2 = x1 + Math.cos(angle) * len;
                const y2 = y1 + Math.sin(angle) * len;

                ctx.strokeStyle = i % 2 === 0
                    ? 'rgba(180, 188, 198, 0.22)'
                    : 'rgba(203, 213, 225, 0.26)';
                ctx.lineWidth = 1 + Math.random() * 1.1;
                ctx.beginPath();
                ctx.moveTo(x1, y1);
                ctx.lineTo(x2, y2);
                ctx.stroke();
            }
            ctx.restore();
        }

        function drawViewOnCanvas(ctx, drawingsView, ox, oy, size, label) {
            ctx.save();
            // Título de la vista
            ctx.fillStyle = '#334155';
            ctx.font = '700 20px Inter, system-ui, sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText(label, ox + size / 2, oy - 12);

            // Fondo blanco y cuadrícula tenue
            ctx.fillStyle = 'rgba(255,255,255,0.92)';
            ctx.fillRect(ox, oy, size, size);

            const step = size / GRID_SIZE;
            ctx.strokeStyle = '#cbd5e1';
            ctx.lineWidth = 1.5;
            ctx.setLineDash([]);
            for (let i = 0; i <= GRID_SIZE; i++) {
                ctx.beginPath();
                ctx.moveTo(ox, oy + i * step);
                ctx.lineTo(ox + size, oy + i * step);
                ctx.stroke();

                ctx.beginPath();
                ctx.moveTo(ox + i * step, oy);
                ctx.lineTo(ox + i * step, oy + size);
                ctx.stroke();
            }

            // Segmentos dibujados por el alumno
            for (const [segId, type] of Object.entries(drawingsView || {})) {
                const parts = segId.split('-');
                const kind = parts[0];
                const r = parseInt(parts[1], 10);
                const c = parseInt(parts[2], 10);

                let x1, y1, x2, y2;
                if (kind === 'H')  { x1 = c; y1 = r;     x2 = c + 1; y2 = r; }
                if (kind === 'V')  { x1 = c; y1 = r;     x2 = c;     y2 = r + 1; }
                if (kind === 'D2') { x1 = c; y1 = r;     x2 = c + 1; y2 = r + 1; }
                if (kind === 'D1') { x1 = c; y1 = r + 1; x2 = c + 1; y2 = r; }

                ctx.beginPath();
                ctx.moveTo(ox + x1 * step, oy + y1 * step);
                ctx.lineTo(ox + x2 * step, oy + y2 * step);

                if (type === 'solid') {
                    ctx.strokeStyle = '#0f172a';
                    ctx.lineWidth = 4.5;
                    ctx.lineCap = 'round';
                    ctx.setLineDash([]);
                } else {
                    ctx.strokeStyle = '#334155';
                    ctx.lineWidth = 3.5;
                    ctx.lineCap = 'butt';
                    ctx.setLineDash([10, 7]);
                }
                ctx.stroke();
            }
            ctx.restore();
        }

        function renderDiplomaCoverCanvas(isOfficial, levelLabel, solvedCount, totalCount, dateStr) {
            const W = 1654, H = 2339; // A4 @ 200 DPI
            const canvas = document.createElement('canvas');
            canvas.width = W;
            canvas.height = H;
            const ctx = canvas.getContext('2d');

            drawAntiForgeryBackground(ctx, W, H);

            // Marcos ornamentales
            const accent = isOfficial ? '#d97706' : '#2563eb';
            ctx.strokeStyle = accent;
            ctx.lineWidth = 14;
            ctx.strokeRect(75, 75, W - 150, H - 150);

            ctx.strokeStyle = '#94a3b8';
            ctx.lineWidth = 3;
            ctx.strokeRect(102, 102, W - 204, H - 204);

            // Cabecera institucional
            ctx.fillStyle = accent;
            ctx.font = '800 32px Inter, system-ui, sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText('TALLER DE VISTAS DIÉDRICAS 3D · SISTEMA EUROPEO (ISO-E)', W / 2, 260);

            // Título principal
            ctx.fillStyle = '#0f172a';
            ctx.font = '800 76px Inter, system-ui, sans-serif';
            ctx.fillText(
                isOfficial ? 'DIPLOMA OFICIAL DE SUPERACIÓN' : 'CERTIFICADO DE AVANCE',
                W / 2,
                430
            );

            // Línea divisoria
            ctx.strokeStyle = accent;
            ctx.lineWidth = 6;
            ctx.beginPath();
            ctx.moveTo(W / 2 - 260, 485);
            ctx.lineTo(W / 2 + 260, 485);
            ctx.stroke();

            // Texto de concesión
            ctx.fillStyle = '#475569';
            ctx.font = '500 36px Inter, system-ui, sans-serif';
            ctx.fillText('Se otorga el presente documento acreditativo a:', W / 2, 620);

            // Nombre del alumno
            ctx.fillStyle = '#0f172a';
            ctx.font = '800 68px Inter, system-ui, sans-serif';
            ctx.fillText(state.userName, W / 2, 740);

            ctx.strokeStyle = '#cbd5e1';
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.moveTo(280, 775);
            ctx.lineTo(W - 280, 775);
            ctx.stroke();

            // Descripción del logro
            ctx.fillStyle = '#334155';
            ctx.font = '500 34px Inter, system-ui, sans-serif';
            if (isOfficial) {
                ctx.fillText('Por haber resuelto satisfactoriamente la totalidad de las 10 figuras', W / 2, 900);
                ctx.fillText('de representación diédrica tridimensional correspondientes al nivel:', W / 2, 955);
            } else {
                ctx.fillText('Por el progreso acreditado en la representación de vistas diédricas', W / 2, 900);
                ctx.fillText('tridimensionales (Alzado, Perfil Izquierdo y Planta) en el nivel:', W / 2, 955);
            }

            // Caja destacada de Nivel y Resultado
            ctx.fillStyle = isOfficial ? 'rgba(254, 243, 199, 0.85)' : 'rgba(239, 246, 255, 0.85)';
            ctx.strokeStyle = accent;
            ctx.lineWidth = 5;
            ctx.beginPath();
            ctx.roundRect(330, 1040, W - 660, 290, 32);
            ctx.fill();
            ctx.stroke();

            ctx.fillStyle = accent;
            ctx.font = '800 56px Inter, system-ui, sans-serif';
            ctx.fillText(`NIVEL ${levelLabel.toUpperCase()}`, W / 2, 1155);

            ctx.fillStyle = '#0f172a';
            ctx.font = '700 40px Inter, system-ui, sans-serif';
            ctx.fillText(`Figuras resueltas: ${solvedCount} de ${totalCount} (${solvedCount * 10}%)`, W / 2, 1255);

            // Fecha y sello de verificación
            ctx.fillStyle = '#475569';
            ctx.font = '600 30px Inter, system-ui, sans-serif';
            ctx.fillText(`Fecha de emisión: ${dateStr}`, W / 2, 1520);

            const codeSeed = `${state.userName}|${levelLabel}|${solvedCount}|${dateStr}`;
            let hash = 0;
            for (let i = 0; i < codeSeed.length; i++) {
                hash = ((hash << 5) - hash + codeSeed.charCodeAt(i)) | 0;
            }
            const verCode = `ISOE-${Math.abs(hash).toString(16).toUpperCase().padStart(8, '0')}`;

            ctx.fillStyle = '#64748b';
            ctx.font = '600 24px monospace';
            ctx.fillText(`Código de verificación: ${verCode}`, W / 2, 1585);

            ctx.fillStyle = '#64748b';
            ctx.font = '500 26px Inter, system-ui, sans-serif';
            ctx.fillText(
                solvedCount > 0
                    ? 'En las páginas siguientes se adjuntan las figuras resueltas y sus vistas.'
                    : 'Aún no se ha completado ninguna figura en este nivel.',
                W / 2,
                1760
            );

            return canvas;
        }

        function loadImageAsync(src) {
            return new Promise((resolve) => {
                if (!src) { resolve(null); return; }
                const img = new Image();
                img.onload = () => resolve(img);
                img.onerror = () => resolve(null);
                img.src = src;
            });
        }

        async function renderSolvedFiguresPageCanvas(pairItems, pageIndex, totalPages, levelLabel) {
            const W = 1654, H = 2339;
            const canvas = document.createElement('canvas');
            canvas.width = W;
            canvas.height = H;
            const ctx = canvas.getContext('2d');

            drawAntiForgeryBackground(ctx, W, H);

            // Marco y cabecera de anexo
            ctx.strokeStyle = '#94a3b8';
            ctx.lineWidth = 4;
            ctx.strokeRect(75, 75, W - 150, H - 150);

            ctx.fillStyle = '#0f172a';
            ctx.font = '800 32px Inter, system-ui, sans-serif';
            ctx.textAlign = 'left';
            ctx.fillText(`ANEXO DE FIGURAS RESUELTAS · NIVEL ${levelLabel.toUpperCase()}`, 120, 145);

            ctx.fillStyle = '#64748b';
            ctx.font = '600 26px Inter, system-ui, sans-serif';
            ctx.textAlign = 'right';
            ctx.fillText(`Alumno/a: ${state.userName} · Pág. ${pageIndex}/${totalPages}`, W - 120, 145);

            // Renderizar hasta 2 figuras resueltas por página
            for (let slot = 0; slot < pairItems.length; slot++) {
                const { index, item } = pairItems[slot];
                const boxY = 200 + slot * 1010;
                const boxH = 950;

                ctx.fillStyle = 'rgba(255, 255, 255, 0.88)';
                ctx.strokeStyle = '#cbd5e1';
                ctx.lineWidth = 3;
                ctx.beginPath();
                ctx.roundRect(120, boxY, W - 240, boxH, 24);
                ctx.fill();
                ctx.stroke();

                // Título de la figura
                ctx.fillStyle = '#1e293b';
                ctx.font = '800 30px Inter, system-ui, sans-serif';
                ctx.textAlign = 'left';
                ctx.fillText(
                    `Figura #${index + 1} · Dificultad: ${DIFFICULTY_META[item.difficulty].label}`,
                    160,
                    boxY + 58
                );

                // Imagen 3D isométrica a la izquierda
                const thumbSrc = item.thumbnail || renderThumbnailForGrid(item.grid);
                const img = await loadImageAsync(thumbSrc);
                const imgBoxX = 165, imgBoxY = boxY + 115, imgSize = 520;

                ctx.fillStyle = '#ffffff';
                ctx.strokeStyle = '#e2e8f0';
                ctx.lineWidth = 2;
                ctx.fillRect(imgBoxX, imgBoxY, imgSize, imgSize);
                ctx.strokeRect(imgBoxX, imgBoxY, imgSize, imgSize);

                if (img) {
                    ctx.drawImage(img, imgBoxX + 10, imgBoxY + 10, imgSize - 20, imgSize - 20);
                }

                ctx.fillStyle = '#64748b';
                ctx.font = '600 22px Inter, system-ui, sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText('Perspectiva Isométrica 3D', imgBoxX + imgSize / 2, imgBoxY + imgSize + 38);

                // Tres vistas en Sistema Europeo a la derecha
                const vSize = 310;
                const gap = 55;
                const vBaseX = 770;
                const vBaseY = boxY + 135;

                drawViewOnCanvas(ctx, item.drawings.alzado, vBaseX, vBaseY, vSize, 'ALZADO');
                drawViewOnCanvas(ctx, item.drawings.perfil, vBaseX + vSize + gap, vBaseY, vSize, 'PERFIL IZQ.');
                drawViewOnCanvas(ctx, item.drawings.planta, vBaseX, vBaseY + vSize + 75, vSize, 'PLANTA');
            }

            return canvas;
        }

        async function generateEvaluationPDF(isOfficial) {
            if (!window.jspdf || !window.jspdf.jsPDF) {
                showToast('Error al cargar el generador de PDF');
                return;
            }

            showToast('Generando documento PDF rasterizado...');
            const lvl = state.evalData[state.evalLevel];
            const levelLabel = EVAL_BLUEPRINTS[state.evalLevel].label;
            const solvedItems = lvl.sequence
                .map((item, index) => ({ item, index }))
                .filter(entry => entry.item.solved);

            const dateStr = new Date().toLocaleDateString('es-ES', {
                day: '2-digit', month: '2-digit', year: 'numeric'
            });

            const { jsPDF } = window.jspdf;
            const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });

            // Portada rasterizada
            const coverCanvas = renderDiplomaCoverCanvas(
                isOfficial,
                levelLabel,
                solvedItems.length,
                lvl.sequence.length,
                dateStr
            );
            doc.addImage(coverCanvas.toDataURL('image/jpeg', 0.92), 'JPEG', 0, 0, 210, 297);

            // Páginas anexas con las figuras resueltas (2 por página)
            const totalAnnexPages = Math.ceil(solvedItems.length / 2);
            for (let p = 0; p < totalAnnexPages; p++) {
                const slice = solvedItems.slice(p * 2, p * 2 + 2);
                const pageCanvas = await renderSolvedFiguresPageCanvas(slice, p + 1, totalAnnexPages, levelLabel);
                doc.addPage();
                doc.addImage(pageCanvas.toDataURL('image/jpeg', 0.92), 'JPEG', 0, 0, 210, 297);
            }

            const safeUser = (state.userName || 'alumno')
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                .replace(/[^a-zA-Z0-9_-]+/g, '_');
            const prefix = isOfficial ? 'Diploma_Oficial' : 'Certificado_Avance';
            doc.save(`${prefix}_${levelLabel}_${safeUser}.pdf`);
            showToast('PDF descargado correctamente');
        }

        /* =========================================================================
         * INICIALIZACIÓN Y EVENTOS DE INTERFAZ
         * ========================================================================= */
        function bindUIEvents() {
            // Login
            document.getElementById('login-form').addEventListener('submit', (e) => {
                e.preventDefault();
                const input = document.getElementById('student-name-input');
                const val = input.value.trim();
                if (!val) {
                    document.getElementById('login-error').classList.remove('hidden');
                    input.focus();
                    return;
                }
                restoreUserSession(val);
            });

            // Logout
            document.getElementById('btn-logout').addEventListener('click', () => {
                openConfirmModal(
                    'Cerrar sesión',
                    `¿Deseas cerrar la sesión de ${state.userName}? Tu progreso queda guardado automáticamente en este dispositivo.`,
                    'Cerrar sesión',
                    logoutUser
                );
            });

            // Modal de confirmación
            document.getElementById('confirm-cancel').addEventListener('click', closeConfirmModal);
            document.getElementById('confirm-ok').addEventListener('click', () => {
                const cb = confirmCallback;
                closeConfirmModal();
                if (cb) cb();
            });

            // Modal de enhorabuena
            document.getElementById('btn-congrats-close').addEventListener('click', () => {
                document.getElementById('congrats-modal').classList.add('hidden');
            });
            document.getElementById('btn-congrats-pdf').addEventListener('click', () => {
                document.getElementById('congrats-modal').classList.add('hidden');
                generateEvaluationPDF(true);
            });

            // Modal .sav (Guardar / Cargar avance cifrado)
            document.getElementById('btn-sav-manager').addEventListener('click', openSavModal);
            document.getElementById('btn-sav-close').addEventListener('click', closeSavModal);
            document.getElementById('btn-sav-download').addEventListener('click', handleDownloadSav);
            document.getElementById('btn-sav-upload').addEventListener('click', () => {
                const inp = document.getElementById('sav-file-input');
                inp.value = '';
                inp.click();
            });
            document.getElementById('sav-file-input').addEventListener('change', (e) => {
                const file = e.target.files?.[0];
                if (file) handleUploadSavFile(file);
            });

            // Selector de modo Práctica / Evaluación
            document.getElementById('tab-practice').addEventListener('click', () => switchMode('practice'));
            document.getElementById('tab-eval').addEventListener('click', () => switchMode('eval'));

            // Controles de Práctica
            document.getElementById('practice-diff-select').addEventListener('change', (e) => {
                state.practiceDifficulty = e.target.value;
                saveStateToStorage();
                startNewPracticeFigure();
            });
            document.getElementById('btn-export-stl').addEventListener('click', exportCurrentFigureSTL);
            document.getElementById('btn-new-figure').addEventListener('click', startNewPracticeFigure);
            document.getElementById('btn-check-practice').addEventListener('click', checkPracticeDrawing);
            document.getElementById('btn-solution').addEventListener('click', () => {
                state.showSolution = !state.showSolution;
                document.getElementById('btn-solution-text').textContent =
                    state.showSolution ? 'Ocultar solución' : 'Ver solución';
                renderAllViews();
            });

            // Controles de Evaluación
            document.querySelectorAll('.eval-tab').forEach(btn => {
                btn.addEventListener('click', () => {
                    saveStateToStorage();
                    state.evalLevel = btn.dataset.evalLevel;
                    ensureEvalLevelInitialized(state.evalLevel);
                    loadEvalStep(state.evalData[state.evalLevel].currentIndex);
                    saveStateToStorage();
                });
            });

            document.getElementById('btn-reroll-eval').addEventListener('click', rerollCurrentEvalFigure);
            document.getElementById('btn-check-eval').addEventListener('click', checkEvaluationDrawing);
            document.getElementById('btn-next-eval').addEventListener('click', () => {
                const lvl = state.evalData[state.evalLevel];
                if (lvl && lvl.currentIndex < 9 && lvl.sequence[lvl.currentIndex].solved) {
                    loadEvalStep(lvl.currentIndex + 1);
                    saveStateToStorage();
                }
            });

            document.getElementById('btn-pdf-progress').addEventListener('click', () => generateEvaluationPDF(false));
            document.getElementById('btn-pdf-official').addEventListener('click', () => generateEvaluationPDF(true));

            document.getElementById('btn-reset-eval').addEventListener('click', () => {
                const levelName = EVAL_BLUEPRINTS[state.evalLevel].label;
                openConfirmModal(
                    `Reiniciar nivel ${levelName}`,
                    'Se borrará el avance actual de este nivel y se generarán 10 figuras nuevas. ¿Deseas continuar?',
                    'Reiniciar nivel',
                    () => {
                        state.evalData[state.evalLevel] = null;
                        ensureEvalLevelInitialized(state.evalLevel);
                        loadEvalStep(0);
                        saveStateToStorage();
                        showToast(`Nivel ${levelName} reiniciado`);
                    }
                );
            });

            // Herramientas de dibujo
            document.querySelectorAll('.tool-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    state.tool = btn.dataset.tool;
                    document.querySelectorAll('.tool-btn').forEach(b => b.classList.toggle('active', b === btn));
                });
            });

            document.getElementById('btn-undo').addEventListener('click', () => {
                if (state.history.length === 0) return;
                state.drawings = state.history.pop();
                updateUndoButton();
                clearCheckFeedback();
                renderAllViews();
                saveStateToStorage();
            });

            document.getElementById('btn-clear').addEventListener('click', () => {
                pushHistorySnapshot();
                state.drawings = createEmptyDrawings();
                clearCheckFeedback();
                renderAllViews();
                saveStateToStorage();
            });

            document.getElementById('btn-clear-check').addEventListener('click', clearCheckFeedback);

            // Atajo teclado Ctrl+Z / Cmd+Z
            window.addEventListener('keydown', (e) => {
                if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z') {
                    if (document.activeElement && document.activeElement.tagName === 'INPUT') return;
                    e.preventDefault();
                    document.getElementById('btn-undo').click();
                }
            });

            // Controles visor 3D
            document.getElementById('btn-unit-grid').addEventListener('click', (e) => {
                state.showUnitGrid = !state.showUnitGrid;
                if (unitGridLines) unitGridLines.visible = state.showUnitGrid;
                e.currentTarget.classList.toggle('bg-blue-50', state.showUnitGrid);
                e.currentTarget.classList.toggle('text-blue-700', state.showUnitGrid);
                e.currentTarget.classList.toggle('border-blue-300', state.showUnitGrid);
            });

            document.querySelectorAll('.cam-btn').forEach(btn => {
                btn.addEventListener('click', () => setCameraPreset(btn.dataset.cam));
            });

            // Conmutador de vistas en móvil/tablet
            document.querySelectorAll('.mobile-view-btn').forEach(btn => {
                btn.addEventListener('click', () => setMobileView(btn.dataset.mobileView));
            });
        }

        window.addEventListener('DOMContentLoaded', () => {
            initThreeScene();
            buildDraftingBoards();
            bindUIEvents();

            const root = loadStorageRoot();
            if (root.activeUser) {
                restoreUserSession(root.activeUser);
            } else {
                startNewPracticeFigure();
                document.getElementById('login-modal').classList.remove('hidden');
                setTimeout(() => document.getElementById('student-name-input').focus(), 80);
            }
        });
    </script>
