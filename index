        function init3D() {
            const container = document.getElementById('viewport-3d');
            const width = container.clientWidth || 400;
            const height = container.clientHeight || 360;

            scene = new THREE.Scene();

            camera = new THREE.PerspectiveCamera(36, width / height, 0.1, 100);
            // Vista isométrica en octante (-X, +Y, +Z): Alzado (+Z) a la derecha y Perfil Izquierdo (-X) a la izquierda
            camera.position.set(-5.2, 4.6, 5.2);

            renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, preserveDrawingBuffer: true });
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            renderer.setSize(width, height);
            // SIN SOMBRAS (estricto)
            renderer.shadowMap.enabled = false;
            container.appendChild(renderer.domElement);

            controls = new OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;
            controls.dampingFactor = 0.08;
            controls.enablePan = false;
            controls.minDistance = 4.2;
            controls.maxDistance = 15;
            controls.target.set(0, 0, 0);

            // Iluminación limpia sin sombras proyectadas
            scene.add(new THREE.AmbientLight(0xffffff, 0.48));

            const hemiLight = new THREE.HemisphereLight(0xffffff, 0xdbeafe, 0.35);
            hemiLight.position.set(0, 10, 0);
            scene.add(hemiLight);

            const dirMain = new THREE.DirectionalLight(0xffffff, 0.62);
            dirMain.position.set(6, 11, 8);
            dirMain.castShadow = false;
            scene.add(dirMain);

            const dirFill = new THREE.DirectionalLight(0xe0f2fe, 0.36);
            dirFill.position.set(-8, 4, -5);
            dirFill.castShadow = false;
            scene.add(dirFill);

            const dirBottom = new THREE.DirectionalLight(0xfef3c7, 0.18);
            dirBottom.position.set(2, -7, 3);
            dirBottom.castShadow = false;
            scene.add(dirBottom);

            buildReferenceBase();

            figureGroup = new THREE.Group();
            scene.add(figureGroup);

            const resizeObserver = new ResizeObserver(() => {
                const w = container.clientWidth;
                const h = container.clientHeight;
                if (w > 0 && h > 0) {
                    camera.aspect = w / h;
                    camera.updateProjectionMatrix();
                    renderer.setSize(w, h);
                }
            });
            resizeObserver.observe(container);
        }

        function roundRectCanvas(ctx, x, y, w, h, r) {
            ctx.beginPath();
            ctx.moveTo(x + r, y);
            ctx.arcTo(x + w, y, x + w, y + h, r);
            ctx.arcTo(x + w, y + h, x, y + h, r);
            ctx.arcTo(x, y + h, x, y, r);
            ctx.arcTo(x, y, x + w, y, r);
            ctx.closePath();
        }

        function createFloorLabelTexture(text, colorHex) {
            const canvas = document.createElement('canvas');
            canvas.width = 512;
            canvas.height = 256;
            const ctx = canvas.getContext('2d');
            ctx.clearRect(0, 0, 512, 256);

            ctx.fillStyle = colorHex;
            ctx.strokeStyle = colorHex;
            ctx.lineWidth = 10;
            ctx.lineCap = 'round';

            ctx.beginPath();
            ctx.moveTo(256, 118);
            ctx.lineTo(256, 36);
            ctx.stroke();

            ctx.beginPath();
            ctx.moveTo(222, 72);
            ctx.lineTo(256, 28);
            ctx.lineTo(290, 72);
            ctx.closePath();
            ctx.fill();

            ctx.fillStyle = 'rgba(255, 255, 255, 0.94)';
            roundRectCanvas(ctx, 96, 140, 320, 82, 24);
            ctx.fill();
            ctx.lineWidth = 5;
            ctx.strokeStyle = colorHex;
            ctx.stroke();

            ctx.fillStyle = colorHex;
            ctx.font = '700 44px Inter, sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(text, 256, 183);

            const tex = new THREE.CanvasTexture(canvas);
            tex.anisotropy = 8;
            return tex;
        }

        function buildReferenceBase() {
            const baseY = -1.504;
            const gridHelper = new THREE.GridHelper(3, 3, 0x94a3b8, 0xcbd5e1);
            gridHelper.position.y = baseY;
            scene.add(gridHelper);

            const alzadoPlane = new THREE.Mesh(
                new THREE.PlaneGeometry(2.3, 1.15),
                new THREE.MeshBasicMaterial({ map: createFloorLabelTexture('ALZADO', '#2563eb'), transparent: true, side: THREE.DoubleSide })
            );
            alzadoPlane.rotation.x = -Math.PI / 2;
            alzadoPlane.position.set(0, baseY + 0.008, 2.25);
            scene.add(alzadoPlane);

            const perfilPlane = new THREE.Mesh(
                new THREE.PlaneGeometry(2.3, 1.15),
                new THREE.MeshBasicMaterial({ map: createFloorLabelTexture('PERFIL', '#d97706'), transparent: true, side: THREE.DoubleSide })
            );
            perfilPlane.rotation.x = -Math.PI / 2;
            perfilPlane.rotation.z = -Math.PI / 2;
            perfilPlane.position.set(-2.25, baseY + 0.008, 0);
            scene.add(perfilPlane);
        }

        function populateFigureGroup(targetGroup, grid, meshData, showGuide) {
            while (targetGroup.children.length > 0) {
                const child = targetGroup.children[0];
                if (child.geometry) child.geometry.dispose();
                if (child.material) {
                    if (Array.isArray(child.material)) child.material.forEach(m => m.dispose());
                    else child.material.dispose();
                }
                targetGroup.remove(child);
            }

            const off = -1.5;
            const { triangles, realEdges } = meshData;

            const posArr = new Float32Array(triangles.length * 9);
            const normArr = new Float32Array(triangles.length * 9);
            for (let i = 0; i < triangles.length; i++) {
                const t = triangles[i];
                const idx = i * 9;
                posArr[idx]     = t.v0[0] + off; posArr[idx + 1] = t.v0[1] + off; posArr[idx + 2] = t.v0[2] + off;
                posArr[idx + 3] = t.v1[0] + off; posArr[idx + 4] = t.v1[1] + off; posArr[idx + 5] = t.v1[2] + off;
                posArr[idx + 6] = t.v2[0] + off; posArr[idx + 7] = t.v2[1] + off; posArr[idx + 8] = t.v2[2] + off;
                for (let k = 0; k < 3; k++) {
                    normArr[idx + k * 3]     = t.normal[0];
                    normArr[idx + k * 3 + 1] = t.normal[1];
                    normArr[idx + k * 3 + 2] = t.normal[2];
                }
            }

            const solidGeo = new THREE.BufferGeometry();
            solidGeo.setAttribute('position', new THREE.BufferAttribute(posArr, 3));
            solidGeo.setAttribute('normal', new THREE.BufferAttribute(normArr, 3));
            const solidMesh = new THREE.Mesh(
                solidGeo,
                new THREE.MeshLambertMaterial({ color: 0xf1f5f9, polygonOffset: true, polygonOffsetFactor: 1, polygonOffsetUnits: 1 })
            );
            targetGroup.add(solidMesh);

            const edgePos = new Float32Array(realEdges.length * 6);
            for (let i = 0; i < realEdges.length; i++) {
                const e = realEdges[i];
                const idx = i * 6;
                edgePos[idx]     = e.p0[0] + off; edgePos[idx + 1] = e.p0[1] + off; edgePos[idx + 2] = e.p0[2] + off;
                edgePos[idx + 3] = e.p1[0] + off; edgePos[idx + 4] = e.p1[1] + off; edgePos[idx + 5] = e.p1[2] + off;
            }
            const edgeGeo = new THREE.BufferGeometry();
            edgeGeo.setAttribute('position', new THREE.BufferAttribute(edgePos, 3));
            targetGroup.add(new THREE.LineSegments(edgeGeo, new THREE.LineBasicMaterial({ color: 0x0f172a })));

            const guidePts = [];
            for (let x = 0; x < GRID_SIZE; x++) {
                for (let y = 0; y < GRID_SIZE; y++) {
                    for (let z = 0; z < GRID_SIZE; z++) {
                        if (!grid[x][y][z]) continue;
                        const x0 = x + off, x1 = x + 1 + off;
                        const y0 = y + off, y1 = y + 1 + off;
                        const z0 = z + off, z1 = z + 1 + off;
                        guidePts.push(
                            x0,y0,z0, x1,y0,z0,  x1,y0,z0, x1,y0,z1,  x1,y0,z1, x0,y0,z1,  x0,y0,z1, x0,y0,z0,
                            x0,y1,z0, x1,y1,z0,  x1,y1,z0, x1,y1,z1,  x1,y1,z1, x0,y1,z1,  x0,y1,z1, x0,y1,z0,
                            x0,y0,z0, x0,y1,z0,  x1,y0,z0, x1,y1,z0,  x1,y0,z1, x1,y1,z1,  x0,y0,z1, x0,y1,z1
                        );
                    }
                }
            }
            const guideGeo = new THREE.BufferGeometry();
            guideGeo.setAttribute('position', new THREE.Float32BufferAttribute(guidePts, 3));
            const lines = new THREE.LineSegments(guideGeo, new THREE.LineBasicMaterial({ color: 0x94a3b8, transparent: true, opacity: 0.35 }));
            lines.visible = showGuide;
            targetGroup.add(lines);
            return lines;
        }

        function rebuild3DFigure() {
            unitGridLines = populateFigureGroup(figureGroup, state.grid, state.meshData, state.showUnitGrid);
        }

        /**
         * Captura una imagen 3D isométrica limpia sobre fondo blanco (420x360)
         * para incrustar en los certificados y diplomas PDF.
         */
        function captureIsometricThumbnail(gridToRender) {
            const snapW = 420, snapH = 360;
            const prevBg = scene.background;
            const prevPos = camera.position.clone();
            const prevTarget = controls.target.clone();
            const prevAspect = camera.aspect;
            const prevSize = new THREE.Vector2();
            renderer.getSize(prevSize);
            const prevPR = renderer.getPixelRatio();
            const prevGrid = state.grid;
            const prevMesh = state.meshData;

            const isDifferentGrid = (gridToRender && gridToRender !== state.grid);
            if (isDifferentGrid) {
                populateFigureGroup(figureGroup, gridToRender, buildExactMeshData(gridToRender), false);
            } else if (unitGridLines) {
                unitGridLines.visible = false;
            }

            scene.background = new THREE.Color(0xffffff);
            renderer.setPixelRatio(1);
            renderer.setSize(snapW, snapH, false);
            camera.aspect = snapW / snapH;
            camera.updateProjectionMatrix();
            camera.position.set(-5.2, 4.6, 5.2);
            camera.lookAt(0, 0, 0);

            renderer.render(scene, camera);
            const dataUrl = renderer.domElement.toDataURL('image/png');

            scene.background = prevBg;
            renderer.setPixelRatio(prevPR);
            renderer.setSize(prevSize.x, prevSize.y, false);
            camera.aspect = prevAspect;
            camera.updateProjectionMatrix();
            camera.position.copy(prevPos);
            controls.target.copy(prevTarget);
            camera.lookAt(prevTarget);

            if (isDifferentGrid) {
                unitGridLines = populateFigureGroup(figureGroup, prevGrid, prevMesh, state.showUnitGrid);
            } else if (unitGridLines) {
                unitGridLines.visible = state.showUnitGrid;
            }
            renderer.render(scene, camera);
            return dataUrl;
        }

        function animateCameraTo(preset) {
            const dist = 8.4;
            let targetPos;
            if (preset === 'iso')         targetPos = new THREE.Vector3(-5.2, 4.6, 5.2);
            else if (preset === 'alzado') targetPos = new THREE.Vector3(0, 0, dist);
            else if (preset === 'planta') targetPos = new THREE.Vector3(0, dist, 0.01);
            else if (preset === 'perfil') targetPos = new THREE.Vector3(-dist, 0, 0);

            cameraAnim = {
                startPos: camera.position.clone(),
                endPos: targetPos,
                startTime: performance.now(),
                duration: 420
            };
        }

        function animateLoop() {
            requestAnimationFrame(animateLoop);
            if (cameraAnim) {
                const t = Math.min(1, (performance.now() - cameraAnim.startTime) / cameraAnim.duration);
                const ease = 1 - Math.pow(1 - t, 3);
                camera.position.lerpVectors(cameraAnim.startPos, cameraAnim.endPos, ease);
                camera.lookAt(0, 0, 0);
                if (t >= 1) cameraAnim = null;
            }
            controls.update();
            renderer.render(scene, camera);
        }

        /* =========================================================================
         * TABLEROS DE DIBUJO SVG INTERACTIVOS
         * (ARRASTRE CONTINUO DE VÉRTICE A VÉRTICE EN TIEMPO REAL SIN SOLTAR)
         * ========================================================================= */
        function getSvgCoords(svg, clientX, clientY) {
            const ctm = svg.getScreenCTM();
            if (ctm) {
                const pt = svg.createSVGPoint();
                pt.x = clientX;
                pt.y = clientY;
                const res = pt.matrixTransform(ctm.inverse());
                return { x: res.x, y: res.y };
            }
            const rect = svg.getBoundingClientRect();
            const scale = Math.min(rect.width / TOTAL, rect.height / TOTAL) || 1;
            const offsetX = (rect.width - TOTAL * scale) / 2;
            const offsetY = (rect.height - TOTAL * scale) / 2;
            return {
                x: (clientX - rect.left - offsetX) / scale,
                y: (clientY - rect.top - offsetY) / scale
            };
        }

        function findNearestVertex(x, y, maxDist = 26) {
            let best = null, bestD = maxDist;
            for (let r = 0; r <= GRID_SIZE; r++) {
                for (let c = 0; c <= GRID_SIZE; c++) {
                    const vx = PAD + c * CELL, vy = PAD + r * CELL;
                    const d = Math.hypot(x - vx, y - vy);
                    if (d < bestD) { bestD = d; best = { c, r, x: vx, y: vy, d }; }
                }
            }
            return best;
        }

        function getSegmentsBetweenVertices(v0, v1) {
            const dc = v1.c - v0.c, dr = v1.r - v0.r;
            if (dc === 0 && dr === 0) return [];
            if (dc !== 0 && dr !== 0 && Math.abs(dc) !== Math.abs(dr)) return [];
            const steps = Math.max(Math.abs(dc), Math.abs(dr));
            const sc = Math.sign(dc), sr = Math.sign(dr);
            const ids = [];
            for (let i = 0; i < steps; i++) {
                const cA = v0.c + sc * i, rA = v0.r + sr * i;
                const cB = cA + sc, rB = rA + sr;
                if (sr === 0) ids.push(`H-${rA}-${Math.min(cA, cB)}`);
                else if (sc === 0) ids.push(`V-${Math.min(rA, rB)}-${cA}`);
                else ids.push((sc === sr) ? `D2-${Math.min(rA, rB)}-${Math.min(cA, cB)}` : `D1-${Math.min(rA, rB)}-${Math.min(cA, cB)}`);
            }
            return ids;
        }

        const pointerState = {
            active: false,
            view: null,
            drawAction: null,
            currentVertex: null,
            strokeChanged: false,
            historyPushed: false
        };

        function buildDrawingGrids() {
            const SVG_NS = 'http://www.w3.org/2000/svg';

            for (const view of VIEWS) {
                const container = document.getElementById(`grid-${view}`);
                container.innerHTML = '';

                const svg = document.createElementNS(SVG_NS, 'svg');
                svg.setAttribute('viewBox', `0 0 ${TOTAL} ${TOTAL}`);
                svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');
                svg.setAttribute('class', 'w-full h-full select-none draft-svg');
                svg.addEventListener('contextmenu', (e) => e.preventDefault());

                const layerGuide = document.createElementNS(SVG_NS, 'g');
                const layerSolution = document.createElementNS(SVG_NS, 'g');
                const layerMissing = document.createElementNS(SVG_NS, 'g');
                const layerUser = document.createElementNS(SVG_NS, 'g');
                const layerPreview = document.createElementNS(SVG_NS, 'g');
                svg.append(layerGuide, layerSolution, layerMissing, layerUser, layerPreview);

                const bgRect = document.createElementNS(SVG_NS, 'rect');
                bgRect.setAttribute('x', PAD); bgRect.setAttribute('y', PAD);
                bgRect.setAttribute('width', CELL * GRID_SIZE); bgRect.setAttribute('height', CELL * GRID_SIZE);
                bgRect.setAttribute('fill', '#f8fafc'); bgRect.setAttribute('rx', '3');
                layerGuide.appendChild(bgRect);

                // Diagonales guía muy tenues
                for (let r = 0; r < GRID_SIZE; r++) {
                    for (let c = 0; c < GRID_SIZE; c++) {
                        const x0 = PAD + c * CELL, y0 = PAD + r * CELL;
                        for (const [ax, ay, bx, by] of [[x0, y0, x0 + CELL, y0 + CELL], [x0, y0 + CELL, x0 + CELL, y0]]) {
                            const dg = document.createElementNS(SVG_NS, 'line');
                            dg.setAttribute('x1', ax); dg.setAttribute('y1', ay);
                            dg.setAttribute('x2', bx); dg.setAttribute('y2', by);
                            dg.setAttribute('stroke', '#f1f5f9'); dg.setAttribute('stroke-width', '1');
                            layerGuide.appendChild(dg);
                        }
                    }
                }

                // Cuadrícula 3×3
                for (let i = 0; i <= GRID_SIZE; i++) {
                    const pos = PAD + i * CELL;
                    const hG = document.createElementNS(SVG_NS, 'line');
                    hG.setAttribute('x1', PAD); hG.setAttribute('y1', pos);
                    hG.setAttribute('x2', PAD + CELL * GRID_SIZE); hG.setAttribute('y2', pos);
                    hG.setAttribute('stroke', '#cbd5e1'); hG.setAttribute('stroke-width', '1.4');
                    layerGuide.appendChild(hG);

                    const vG = document.createElementNS(SVG_NS, 'line');
                    vG.setAttribute('x1', pos); vG.setAttribute('y1', PAD);
                    vG.setAttribute('x2', pos); vG.setAttribute('y2', PAD + CELL * GRID_SIZE);
                    vG.setAttribute('stroke', '#cbd5e1'); vG.setAttribute('stroke-width', '1.4');
                    layerGuide.appendChild(vG);
                }

                // Vértices 4×4 bien visibles
                for (let r = 0; r <= GRID_SIZE; r++) {
                    for (let c = 0; c <= GRID_SIZE; c++) {
                        const dot = document.createElementNS(SVG_NS, 'circle');
                        dot.setAttribute('cx', PAD + c * CELL); dot.setAttribute('cy', PAD + r * CELL);
                        dot.setAttribute('r', '4.4'); dot.setAttribute('fill', '#64748b');
                        layerGuide.appendChild(dot);
                    }
                }

                svgRefs[view] = { svg, layerSolution, layerMissing, layerPreview, segments: {} };

                const registerSeg = (id, x1, y1, x2, y2) => {
                    const userLine = document.createElementNS(SVG_NS, 'line');
                    userLine.setAttribute('x1', x1); userLine.setAttribute('y1', y1);
                    userLine.setAttribute('x2', x2); userLine.setAttribute('y2', y2);
                    userLine.setAttribute('class', 'seg-line');
                    userLine.style.display = 'none';
                    layerUser.appendChild(userLine);
                    svgRefs[view].segments[id] = { x1, y1, x2, y2, userLine };
                };

                for (let r = 0; r <= GRID_SIZE; r++)
                    for (let c = 0; c < GRID_SIZE; c++)
                        registerSeg(`H-${r}-${c}`, PAD + c * CELL, PAD + r * CELL, PAD + (c + 1) * CELL, PAD + r * CELL);

                for (let r = 0; r < GRID_SIZE; r++)
                    for (let c = 0; c <= GRID_SIZE; c++)
                        registerSeg(`V-${r}-${c}`, PAD + c * CELL, PAD + r * CELL, PAD + c * CELL, PAD + (r + 1) * CELL);

                for (let r = 0; r < GRID_SIZE; r++) {
                    for (let c = 0; c < GRID_SIZE; c++) {
                        const x0 = PAD + c * CELL, y0 = PAD + r * CELL;
                        registerSeg(`D1-${r}-${c}`, x0, y0 + CELL, x0 + CELL, y0);
                        registerSeg(`D2-${r}-${c}`, x0, y0, x0 + CELL, y0 + CELL);
                    }
                }

                svg.addEventListener('pointerdown', (e) => handleSvgPointerDown(view, e));
                svg.addEventListener('pointermove', (e) => handleSvgPointerMove(view, e));
                svg.addEventListener('pointerleave', () => { if (!pointerState.active) clearPreviewLayer(view); });

                container.appendChild(svg);
            }

            window.addEventListener('pointerup', handleGlobalPointerUp);
            window.addEventListener('pointercancel', handleGlobalPointerUp);
        }

        function clearPreviewLayer(view) {
            svgRefs[view].layerPreview.innerHTML = '';
        }

        function renderVertexDragPreview(view, { action, activeVertex = null, hoverVertex = null, cursorPt = null }) {
            const SVG_NS = 'http://www.w3.org/2000/svg';
            const layer = svgRefs[view].layerPreview;
            layer.innerHTML = '';
            const color = action === 'eraser' ? '#f43f5e' : '#2563eb';

            // Línea elástica sutil desde el último vértice alcanzado hasta el cursor actual
            if (activeVertex && cursorPt) {
                const guide = document.createElementNS(SVG_NS, 'line');
                guide.setAttribute('x1', activeVertex.x); guide.setAttribute('y1', activeVertex.y);
                guide.setAttribute('x2', cursorPt.x); guide.setAttribute('y2', cursorPt.y);
                guide.setAttribute('stroke', color);
                guide.setAttribute('stroke-width', '2');
                guide.setAttribute('stroke-dasharray', '4 4');
                guide.setAttribute('opacity', '0.45');
                layer.appendChild(guide);
            }

            // Anillo en el vértice ancla activo
            if (activeVertex) {
                const ring = document.createElementNS(SVG_NS, 'circle');
                ring.setAttribute('cx', activeVertex.x); ring.setAttribute('cy', activeVertex.y);
                ring.setAttribute('r', '9.5'); ring.setAttribute('fill', color); ring.setAttribute('opacity', '0.24');
                layer.appendChild(ring);

                const dot = document.createElementNS(SVG_NS, 'circle');
                dot.setAttribute('cx', activeVertex.x); dot.setAttribute('cy', activeVertex.y);
                dot.setAttribute('r', '5.5'); dot.setAttribute('fill', color);
                layer.appendChild(dot);
            }

            // Resaltado suave al pasar el ratón por un vértice antes de pulsar
            if (hoverVertex) {
                const ring = document.createElementNS(SVG_NS, 'circle');
                ring.setAttribute('cx', hoverVertex.x); ring.setAttribute('cy', hoverVertex.y);
                ring.setAttribute('r', '8.5'); ring.setAttribute('fill', color); ring.setAttribute('opacity', '0.18');
                layer.appendChild(ring);

                const dot = document.createElementNS(SVG_NS, 'circle');
                dot.setAttribute('cx', hoverVertex.x); dot.setAttribute('cy', hoverVertex.y);
                dot.setAttribute('r', '5.2'); dot.setAttribute('fill', color);
                layer.appendChild(dot);
            }
        }

        function handleSvgPointerDown(view, e) {
            e.preventDefault();
            try { svgRefs[view].svg.setPointerCapture(e.pointerId); } catch (_) {}

            const pt = getSvgCoords(svgRefs[view].svg, e.clientX, e.clientY);
            const startV = findNearestVertex(pt.x, pt.y, 28);
            if (!startV) return;

            const isRightClick = (e.button === 2);
            pointerState.active = true;
            pointerState.view = view;
            pointerState.drawAction = isRightClick ? 'eraser' : state.tool;
            pointerState.currentVertex = startV;
            pointerState.strokeChanged = false;
            pointerState.historyPushed = false;

            renderVertexDragPreview(view, {
                action: pointerState.drawAction,
                activeVertex: startV,
                cursorPt: pt
            });
        }

        function handleSvgPointerMove(view, e) {
            const pt = getSvgCoords(svgRefs[view].svg, e.clientX, e.clientY);

            if (!pointerState.active) {
                if (e.pointerType === 'mouse') {
                    const hoverV = findNearestVertex(pt.x, pt.y, 24);
                    if (hoverV) {
                        renderVertexDragPreview(view, { action: state.tool, hoverVertex: hoverV });
                    } else {
                        clearPreviewLayer(view);
                    }
                }
                return;
            }

            if (pointerState.view !== view) return;

            // Detectar si el puntero pasa por encima de un nuevo vértice y generar las líneas al instante sin soltar
            const targetV = findNearestVertex(pt.x, pt.y, 26);
            if (targetV && (targetV.c !== pointerState.currentVertex.c || targetV.r !== pointerState.currentVertex.r)) {
                const ids = getSegmentsBetweenVertices(pointerState.currentVertex, targetV);
                if (ids.length > 0) {
                    if (!pointerState.historyPushed) {
                        pushHistory();
                        pointerState.historyPushed = true;
                    }

                    const next = pointerState.drawAction === 'eraser' ? null : pointerState.drawAction;
                    for (const id of ids) {
                        const prev = state.drawings[view][id] || null;
                        if (prev !== next) {
                            pointerState.strokeChanged = true;
                            if (next === null) delete state.drawings[view][id];
                            else state.drawings[view][id] = next;
                            renderUserSegment(view, id);
                        }
                    }

                    if (pointerState.strokeChanged && state.checkActive) {
                        clearCheckOverlay();
                    }

                    // El vértice alcanzado pasa a ser el nuevo punto de partida continuo
                    pointerState.currentVertex = targetV;
                }
            }

            renderVertexDragPreview(view, {
                action: pointerState.drawAction,
                activeVertex: pointerState.currentVertex,
                cursorPt: pt
            });
        }

        function handleGlobalPointerUp() {
            if (!pointerState.active) return;
            const view = pointerState.view;
            clearPreviewLayer(view);

            if (pointerState.strokeChanged) {
                updateUndoButton();
                saveStateToStorage();
            } else if (pointerState.historyPushed && state.history.length > 0) {
                state.history.pop();
                updateUndoButton();
            }

            pointerState.active = false;
            pointerState.view = null;
            pointerState.drawAction = null;
            pointerState.currentVertex = null;
            pointerState.strokeChanged = false;
            pointerState.historyPushed = false;
        }

        function renderUserSegment(view, id) {
            const ref = svgRefs[view].segments[id];
            const val = state.drawings[view][id];
            const line = ref.userLine;
            line.classList.remove('seg-solid', 'seg-dashed', 'seg-check-ok', 'seg-check-wrong');
            if (!val) {
                line.style.display = 'none';
            } else {
                line.style.display = 'inline';
                line.classList.add(val === 'solid' ? 'seg-solid' : 'seg-dashed');
            }
        }

        function renderAllUserDrawings() {
            for (const view of VIEWS) {
                for (const id of Object.keys(svgRefs[view].segments)) {
                    renderUserSegment(view, id);
                }
            }
        }

        /* =========================================================================
         * HISTORIAL, LIMPIEZA, COMPROBACIÓN Y SOLUCIÓN
         * ========================================================================= */
        function pushHistory() {
            state.history.push(cloneDrawings(state.drawings));
            if (state.history.length > 60) state.history.shift();
            updateUndoButton();
        }

        function undo() {
            if (state.history.length === 0) return;
            state.drawings = state.history.pop();
            if (state.checkActive) clearCheckOverlay();
            renderAllUserDrawings();
            updateUndoButton();
            saveStateToStorage();
        }

        function clearAllDrawings() {
            const hasAny = VIEWS.some(v => Object.keys(state.drawings[v]).length > 0);
            if (!hasAny) return;
            pushHistory();
            state.drawings = createEmptyDrawings();
            if (state.checkActive) clearCheckOverlay();
            renderAllUserDrawings();
            saveStateToStorage();
            showToast('Tablero limpiado');
        }

        function updateUndoButton() {
            document.getElementById('btn-undo').disabled = state.history.length === 0;
        }

        function checkDrawing() {
            state.checkActive = true;
            const isPractice = (state.mode === 'practice');
            const SVG_NS = 'http://www.w3.org/2000/svg';

            let totalExpected = 0, correctCount = 0, wrongOrExtra = 0, missingCount = 0;
            const perViewStats = {};

            for (const view of VIEWS) {
                const layerMissing = svgRefs[view].layerMissing;
                layerMissing.innerHTML = '';

                const expectedMap = state.solution[view];
                const userMap = state.drawings[view];
                let vExpected = 0, vCorrect = 0, vErrors = 0, vMissing = 0;

                for (const id of Object.keys(svgRefs[view].segments)) {
                    const exp = expectedMap[id] || null;
                    const usr = userMap[id] || null;
                    const ref = svgRefs[view].segments[id];
                    ref.userLine.classList.remove('seg-check-ok', 'seg-check-wrong');

                    if (exp) { totalExpected++; vExpected++; }

                    if (exp && usr === exp) {
                        correctCount++; vCorrect++;
                        if (isPractice) ref.userLine.classList.add('seg-check-ok');
                    } else if (usr && usr !== exp) {
                        wrongOrExtra++; vErrors++;
                        if (isPractice) ref.userLine.classList.add('seg-check-wrong');
                    } else if (exp && !usr) {
                        missingCount++; vMissing++;
                        if (isPractice) {
                            const missLine = document.createElementNS(SVG_NS, 'line');
                            missLine.setAttribute('x1', ref.x1); missLine.setAttribute('y1', ref.y1);
                            missLine.setAttribute('x2', ref.x2); missLine.setAttribute('y2', ref.y2);
                            missLine.setAttribute('class', 'seg-check-missing');
                            if (exp === 'dashed') missLine.setAttribute('stroke-dasharray', '6 6');
                            layerMissing.appendChild(missLine);
                        }
                    }
                }
                perViewStats[view] = { expected: vExpected, correct: vCorrect, errors: vErrors, missing: vMissing };
            }

            const denom = totalExpected + wrongOrExtra;
            const score = denom === 0 ? 100 : Math.round((correctCount / denom) * 100);
            const isPerfect = (correctCount === totalExpected && wrongOrExtra === 0 && missingCount === 0);

            // En modo Evaluación, si hay errores NO se marcan aristas ni se dan pistas por vista
            if (!isPractice && !isPerfect) {
                document.getElementById('feedback-default').classList.add('hidden');
                document.getElementById('feedback-score-box').classList.add('hidden');
                document.getElementById('legend-check').classList.add('hidden');
                document.getElementById('feedback-eval-error').classList.remove('hidden');
                showToast('Hay errores en las vistas. Revisa tu dibujo e inténtalo de nuevo.');
                return;
            }

            document.getElementById('feedback-eval-error').classList.add('hidden');
            document.getElementById('feedback-default').classList.add('hidden');
            document.getElementById('feedback-score-box').classList.remove('hidden');
            document.getElementById('legend-check').classList.toggle('hidden', !isPractice);

            const scoreEl = document.getElementById('score-percent');
            const barEl = document.getElementById('score-bar');
            scoreEl.textContent = `${score}%`;
            barEl.style.width = `${score}%`;

            if (isPerfect) {
                scoreEl.className = 'text-2xl font-extrabold text-emerald-600';
                barEl.className = 'h-full bg-emerald-500 rounded-full transition-all duration-500';
            } else if (score >= 70) {
                scoreEl.className = 'text-2xl font-extrabold text-blue-600';
                barEl.className = 'h-full bg-blue-500 rounded-full transition-all duration-500';
            } else {
                scoreEl.className = 'text-2xl font-extrabold text-amber-600';
                barEl.className = 'h-full bg-amber-500 rounded-full transition-all duration-500';
            }

            const labels = { alzado: 'Alzado', perfil: 'Perfil Izq.', planta: 'Planta' };
            document.getElementById('score-details').innerHTML = VIEWS.map(v => {
                const st = perViewStats[v];
                if (st.correct === st.expected && st.errors === 0) {
                    return `<div class="flex justify-between"><span>${labels[v]}:</span> <span class="text-emerald-600 font-bold">¡Perfecto!</span></div>`;
                }
                const parts = [];
                if (st.missing > 0) parts.push(`<span class="text-amber-600 font-semibold">faltan ${st.missing}</span>`);
                if (st.errors > 0) parts.push(`<span class="text-rose-600 font-semibold">${st.errors} err.</span>`);
                return `<div class="flex justify-between"><span>${labels[v]}:</span> <span>${parts.join(', ')}</span></div>`;
            }).join('');

            if (!isPractice && isPerfect) {
                const lvl = state.evalData[state.evalLevel];
                const item = lvl.sequence[lvl.currentIndex];
                const wasAlreadySolved = item.solved;
                item.solved = true;
                item.drawings = cloneDrawings(state.drawings);
                item.solvedAt = new Date().toISOString();
                item.thumbnail = captureIsometricThumbnail(item.grid);

                const totalSolved = lvl.sequence.filter(s => s.solved).length;
                lvl.completed = (totalSolved === 10);
                saveStateToStorage();
                updateEvalUI();

                if (lvl.completed && !wasAlreadySolved) {
                    openCongratsModal();
                } else {
                    showToast('¡100% correcto! Figura guardada. Puedes continuar.');
                }
            } else if (isPerfect) {
                showToast('¡Excelente! Todas las vistas son 100% correctas.');
            }
        }

        function clearCheckOverlay() {
            state.checkActive = false;
            for (const view of VIEWS) {
                svgRefs[view].layerMissing.innerHTML = '';
                for (const id of Object.keys(svgRefs[view].segments)) {
                    svgRefs[view].segments[id].userLine.classList.remove('seg-check-ok', 'seg-check-wrong');
                }
            }
            document.getElementById('feedback-eval-error').classList.add('hidden');
            document.getElementById('feedback-default').classList.remove('hidden');
            document.getElementById('feedback-score-box').classList.add('hidden');
            document.getElementById('legend-check').classList.add('hidden');
        }

        function toggleSolution() {
            if (state.mode !== 'practice') return;
            state.showSolution = !state.showSolution;
            renderSolutionOverlay();
        }

        function renderSolutionOverlay() {
            const SVG_NS = 'http://www.w3.org/2000/svg';
            const btnText = document.getElementById('btn-solution-text');
            const btn = document.getElementById('btn-solution');
            const active = state.showSolution && state.mode === 'practice';

            if (active) {
                btnText.textContent = 'Ocultar solución';
                btn.classList.add('bg-blue-50', 'border-blue-300', 'text-blue-700');
                btn.classList.remove('bg-white', 'border-slate-300', 'text-slate-700');
            } else {
                btnText.textContent = 'Ver solución';
                btn.classList.remove('bg-blue-50', 'border-blue-300', 'text-blue-700');
                btn.classList.add('bg-white', 'border-slate-300', 'text-slate-700');
            }

            for (const view of VIEWS) {
                const layer = svgRefs[view].layerSolution;
                layer.innerHTML = '';
                if (!active) continue;
                for (const [id, type] of Object.entries(state.solution[view])) {
                    const ref = svgRefs[view].segments[id];
                    if (!ref) continue;
                    const line = document.createElementNS(SVG_NS, 'line');
                    line.setAttribute('x1', ref.x1); line.setAttribute('y1', ref.y1);
                    line.setAttribute('x2', ref.x2); line.setAttribute('y2', ref.y2);
                    line.setAttribute('class', type === 'solid' ? 'seg-solution-solid' : 'seg-solution-dashed');
                    layer.appendChild(line);
                }
            }
        }

        /* =========================================================================
         * GENERACIÓN DE DIPLOMAS Y CERTIFICADOS EN PDF 100% RASTERIZADOS (CANVAS)
         * CON PATRÓN ANTIFALSIFICACIÓN DE LÍNEAS ALEATORIAS EN EL FONDO
         * ========================================================================= */
        const PDF_CANVAS_W = 1654; // A4 vertical a ~200 DPI (210 × 297 mm)
        const PDF_CANVAS_H = 2339;

        function loadImageAsync(src) {
            return new Promise((resolve, reject) => {
                const img = new Image();
                img.onload = () => resolve(img);
                img.onerror = (err) => reject(err);
                img.src = src;
            });
        }

        function drawCanvasRoundRect(ctx, x, y, w, h, r) {
            ctx.beginPath();
            ctx.moveTo(x + r, y);
            ctx.arcTo(x + w, y, x + w, y + h, r);
            ctx.arcTo(x + w, y + h, x, y + h, r);
            ctx.arcTo(x, y + h, x, y, r);
            ctx.arcTo(x, y, x + w, y, r);
            ctx.closePath();
        }

        /**
         * Dibuja un patrón antifalsificación de líneas rectas aleatorias en gris muy claro
         * por todo el fondo de la página antes de pintar marcos, textos y gráficos.
         */
        function drawAntiForgeryBackground(ctx, w, h) {
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, w, h);

            ctx.save();
            const lineCount = 240;
            for (let i = 0; i < lineCount; i++) {
                const x1 = Math.random() * w;
                const y1 = Math.random() * h;
                const angle = Math.random() * Math.PI * 2;
                const len = 140 + Math.random() * 520;
                const x2 = x1 + Math.cos(angle) * len;
                const y2 = y1 + Math.sin(angle) * len;
                const alpha = 0.18 + Math.random() * 0.18;

                ctx.strokeStyle = `rgba(176, 186, 198, ${alpha.toFixed(2)})`;
                ctx.lineWidth = 1 + Math.random() * 1.4;
                ctx.beginPath();
                ctx.moveTo(x1, y1);
                ctx.lineTo(x2, y2);
                ctx.stroke();
            }
            ctx.restore();
        }

        /**
         * Dibuja una vista ortográfica (Alzado, Perfil Izquierdo o Planta) sobre el canvas del PDF.
         */
        function drawViewOnCanvas(ctx, viewDrawings, x, y, size, title, accentColor) {
            const pad = 18;
            const inner = size - pad * 2;
            const cell = inner / GRID_SIZE;

            ctx.save();
            ctx.fillStyle = accentColor;
            ctx.beginPath();
            ctx.arc(x + 10, y - 14, 6, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = '#1e293b';
            ctx.font = '700 22px Inter, sans-serif';
            ctx.textAlign = 'left';
            ctx.textBaseline = 'middle';
            ctx.fillText(title, x + 24, y - 14);

            ctx.fillStyle = 'rgba(255, 255, 255, 0.88)';
            drawCanvasRoundRect(ctx, x, y, size, size, 14);
            ctx.fill();
            ctx.strokeStyle = '#cbd5e1';
            ctx.lineWidth = 2;
            ctx.stroke();

            ctx.strokeStyle = '#cbd5e1';
            ctx.lineWidth = 1.6;
            for (let i = 0; i <= GRID_SIZE; i++) {
                const px = x + pad + i * cell;
                const py = y + pad + i * cell;
                ctx.beginPath();
                ctx.moveTo(x + pad, py);
                ctx.lineTo(x + pad + inner, py);
                ctx.stroke();

                ctx.beginPath();
                ctx.moveTo(px, y + pad);
                ctx.lineTo(px, y + pad + inner);
                ctx.stroke();
            }

            ctx.fillStyle = '#94a3b8';
            for (let r = 0; r <= GRID_SIZE; r++) {
                for (let c = 0; c <= GRID_SIZE; c++) {
                    ctx.beginPath();
                    ctx.arc(x + pad + c * cell, y + pad + r * cell, 3, 0, Math.PI * 2);
                    ctx.fill();
                }
            }

            const map = viewDrawings || {};
            for (const [segId, type] of Object.entries(map)) {
                const parts = segId.split('-');
                const kind = parts[0];
                const r = parseInt(parts[1], 10);
                const c = parseInt(parts[2], 10);

                let x1, y1, x2, y2;
                if (kind === 'H') {
                    x1 = x + pad + c * cell;
                    y1 = y + pad + r * cell;
                    x2 = x + pad + (c + 1) * cell;
                    y2 = y1;
                } else if (kind === 'V') {
                    x1 = x + pad + c * cell;
                    y1 = y + pad + r * cell;
                    x2 = x1;
                    y2 = y + pad + (r + 1) * cell;
                } else if (kind === 'D1') {
                    x1 = x + pad + c * cell;
                    y1 = y + pad + (r + 1) * cell;
                    x2 = x + pad + (c + 1) * cell;
                    y2 = y + pad + r * cell;
                } else if (kind === 'D2') {
                    x1 = x + pad + c * cell;
                    y1 = y + pad + r * cell;
                    x2 = x + pad + (c + 1) * cell;
                    y2 = y + pad + (r + 1) * cell;
                } else {
                    continue;
                }

                ctx.beginPath();
                if (type === 'solid') {
                    ctx.setLineDash([]);
                    ctx.strokeStyle = '#0f172a';
                    ctx.lineWidth = 5.5;
                    ctx.lineCap = 'round';
                } else {
                    ctx.setLineDash([12, 8]);
                    ctx.strokeStyle = '#334155';
                    ctx.lineWidth = 4;
                    ctx.lineCap = 'butt';
                }
                ctx.moveTo(x1, y1);
                ctx.lineTo(x2, y2);
                ctx.stroke();
            }

            ctx.setLineDash([]);
            ctx.restore();
        }

        /**
         * Genera la portada rasterizada del Diploma Oficial o Certificado de Avance.
         */
        function renderDiplomaCoverCanvas({ isOfficial, userName, levelLabel, solvedCount, totalCount, dateStr, verificationCode }) {
            const canvas = document.createElement('canvas');
            canvas.width = PDF_CANVAS_W;
            canvas.height = PDF_CANVAS_H;
            const ctx = canvas.getContext('2d');

            drawAntiForgeryBackground(ctx, PDF_CANVAS_W, PDF_CANVAS_H);

            const primaryColor = isOfficial ? '#b45309' : '#3730a3';
            const accentColor = isOfficial ? '#f59e0b' : '#4f46e5';
            const softBg = isOfficial ? 'rgba(254, 243, 199, 0.72)' : 'rgba(224, 231, 255, 0.72)';

            ctx.strokeStyle = primaryColor;
            ctx.lineWidth = 10;
            drawCanvasRoundRect(ctx, 70, 70, PDF_CANVAS_W - 140, PDF_CANVAS_H - 140, 36);
            ctx.stroke();

            ctx.strokeStyle = accentColor;
            ctx.lineWidth = 3;
            drawCanvasRoundRect(ctx, 96, 96, PDF_CANVAS_W - 192, PDF_CANVAS_H - 192, 26);
            ctx.stroke();

            const cx = PDF_CANVAS_W / 2;
            ctx.fillStyle = softBg;
            ctx.beginPath();
            ctx.arc(cx, 290, 96, 0, Math.PI * 2);
            ctx.fill();
            ctx.strokeStyle = accentColor;
            ctx.lineWidth = 6;
            ctx.stroke();

            ctx.fillStyle = primaryColor;
            ctx.font = '800 72px Inter, sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(isOfficial ? '★' : '3D', cx, 294);

            ctx.fillStyle = '#475569';
            ctx.font = '700 28px Inter, sans-serif';
            ctx.fillText('TALLER DE VISTAS DIÉDRICAS 3D · SISTEMA EUROPEO (ISO-E)', cx, 455);

            ctx.fillStyle = primaryColor;
            ctx.font = '800 76px Inter, sans-serif';
            ctx.fillText(isOfficial ? 'DIPLOMA OFICIAL' : 'CERTIFICADO DE AVANCE', cx, 565);

            ctx.strokeStyle = accentColor;
            ctx.lineWidth = 5;
            ctx.beginPath();
            ctx.moveTo(cx - 280, 625);
            ctx.lineTo(cx + 280, 625);
            ctx.stroke();

            ctx.fillStyle = '#334155';
            ctx.font = '500 34px Inter, sans-serif';
            ctx.fillText('Se certifica que el alumno / la alumna:', cx, 750);

            ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
            drawCanvasRoundRect(ctx, 180, 815, PDF_CANVAS_W - 360, 150, 24);
            ctx.fill();
            ctx.strokeStyle = '#cbd5e1';
            ctx.lineWidth = 3;
            ctx.stroke();

            let nameFontSize = 64;
            ctx.font = `800 ${nameFontSize}px Inter, sans-serif`;
            while (ctx.measureText(userName).width > PDF_CANVAS_W - 430 && nameFontSize > 32) {
                nameFontSize -= 4;
                ctx.font = `800 ${nameFontSize}px Inter, sans-serif`;
            }
            ctx.fillStyle = '#0f172a';
            ctx.fillText(userName, cx, 892);

            ctx.fillStyle = '#334155';
            ctx.font = '500 34px Inter, sans-serif';
            const desc1 = isOfficial
                ? 'ha superado satisfactoriamente todas las figuras de evaluación'
                : 'ha completado correctamente hasta el momento las siguientes';
            const desc2 = isOfficial
                ? 'en representación de vistas ortográficas (Alzado, Perfil Izquierdo y Planta).'
                : 'figuras de evaluación en representación de vistas ortográficas 3D.';
            ctx.fillText(desc1, cx, 1075);
            ctx.fillText(desc2, cx, 1128);

            const cardY = 1235;
            const cardW = 580;
            const cardH = 240;
            const gap = 70;
            const leftX = cx - cardW - gap / 2;
            const rightX = cx + gap / 2;

            ctx.fillStyle = 'rgba(248, 250, 252, 0.9)';
            drawCanvasRoundRect(ctx, leftX, cardY, cardW, cardH, 24);
            ctx.fill();
            ctx.strokeStyle = '#cbd5e1';
            ctx.lineWidth = 3;
            ctx.stroke();

            ctx.fillStyle = '#64748b';
            ctx.font = '700 26px Inter, sans-serif';
            ctx.fillText('NIVEL DE DIFICULTAD', leftX + cardW / 2, cardY + 72);

            ctx.fillStyle = primaryColor;
            ctx.font = '800 56px Inter, sans-serif';
            ctx.fillText(levelLabel.toUpperCase(), leftX + cardW / 2, cardY + 155);

            ctx.fillStyle = 'rgba(248, 250, 252, 0.9)';
            drawCanvasRoundRect(ctx, rightX, cardY, cardW, cardH, 24);
            ctx.fill();
            ctx.strokeStyle = '#cbd5e1';
            ctx.lineWidth = 3;
            ctx.stroke();

            ctx.fillStyle = '#64748b';
            ctx.font = '700 26px Inter, sans-serif';
            ctx.fillText('FIGURAS RESUELTAS', rightX + cardW / 2, cardY + 72);

            ctx.fillStyle = solvedCount === totalCount ? '#059669' : '#0f172a';
            ctx.font = '800 56px Inter, sans-serif';
            ctx.fillText(`${solvedCount} / ${totalCount}`, rightX + cardW / 2, cardY + 155);

            const barW = 1040;
            const barH = 34;
            const barX = cx - barW / 2;
            const barY = 1580;

            ctx.fillStyle = '#e2e8f0';
            drawCanvasRoundRect(ctx, barX, barY, barW, barH, 17);
            ctx.fill();

            const pct = Math.max(0, Math.min(1, solvedCount / totalCount));
            if (pct > 0) {
                ctx.fillStyle = isOfficial ? '#f59e0b' : '#4f46e5';
                drawCanvasRoundRect(ctx, barX, barY, Math.max(34, barW * pct), barH, 17);
                ctx.fill();
            }

            ctx.fillStyle = '#475569';
            ctx.font = '700 28px Inter, sans-serif';
            ctx.fillText(`Progreso completado: ${Math.round(pct * 100)}%`, cx, barY + 72);

            ctx.fillStyle = '#475569';
            ctx.font = '500 26px Inter, sans-serif';
            const annexNote = solvedCount > 0
                ? 'En las páginas siguientes se adjuntan todas las piezas 3D resueltas y sus vistas dibujadas.'
                : 'Aún no se ha completado ninguna figura en este nivel de evaluación.';
            ctx.fillText(annexNote, cx, 1840);

            ctx.strokeStyle = '#cbd5e1';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(160, 2030);
            ctx.lineTo(PDF_CANVAS_W - 160, 2030);
            ctx.stroke();

            ctx.textAlign = 'left';
            ctx.fillStyle = '#475569';
            ctx.font = '600 26px Inter, sans-serif';
            ctx.fillText(`Fecha de emisión: ${dateStr}`, 170, 2095);

            ctx.textAlign = 'right';
            ctx.fillText(`Código: ${verificationCode}`, PDF_CANVAS_W - 170, 2095);

            ctx.textAlign = 'center';
            ctx.fillStyle = '#94a3b8';
            ctx.font = '500 22px Inter, sans-serif';
            ctx.fillText('Documento rasterizado con trama antifalsificación · Taller de Vistas Diédricas 3D', cx, 2180);

            return canvas.toDataURL('image/jpeg', 0.92);
        }

        /**
         * Genera una página anexa rasterizada con hasta 2 figuras resueltas.
         */
        async function renderSolvedFiguresPageCanvas({ items, pageNum, totalPages, userName, levelLabel }) {
            const canvas = document.createElement('canvas');
            canvas.width = PDF_CANVAS_W;
            canvas.height = PDF_CANVAS_H;
            const ctx = canvas.getContext('2d');

            drawAntiForgeryBackground(ctx, PDF_CANVAS_W, PDF_CANVAS_H);

            ctx.fillStyle = 'rgba(248, 250, 252, 0.9)';
            drawCanvasRoundRect(ctx, 70, 60, PDF_CANVAS_W - 140, 105, 18);
            ctx.fill();
            ctx.strokeStyle = '#cbd5e1';
            ctx.lineWidth = 2;
            ctx.stroke();

            ctx.textAlign = 'left';
            ctx.textBaseline = 'middle';
            ctx.fillStyle = '#0f172a';
            ctx.font = '800 32px Inter, sans-serif';
            ctx.fillText(`Anexo de Figuras Resueltas · Nivel ${levelLabel}`, 105, 98);

            ctx.fillStyle = '#475569';
            ctx.font = '600 23px Inter, sans-serif';
            ctx.fillText(`Alumno/a: ${userName}`, 105, 138);

            ctx.textAlign = 'right';
            ctx.fillStyle = '#64748b';
            ctx.font = '700 24px Inter, sans-serif';
            ctx.fillText(`Página ${pageNum} de ${totalPages}`, PDF_CANVAS_W - 105, 114);

            const cardH = 980;
            const startY = 200;
            const cardGap = 55;

            for (let i = 0; i < items.length; i++) {
                const entry = items[i];
                const topY = startY + i * (cardH + cardGap);

                ctx.fillStyle = 'rgba(255, 255, 255, 0.84)';
                drawCanvasRoundRect(ctx, 70, topY, PDF_CANVAS_W - 140, cardH, 24);
                ctx.fill();
                ctx.strokeStyle = '#94a3b8';
                ctx.lineWidth = 2.5;
                ctx.stroke();

                const diffLabel = DIFFICULTY_META[entry.item.difficulty]?.label || entry.item.difficulty;
                ctx.textAlign = 'left';
                ctx.fillStyle = '#0f172a';
                ctx.font = '800 34px Inter, sans-serif';
                ctx.fillText(`Figura #${entry.index + 1}`, 110, topY + 56);

                ctx.fillStyle = '#e0f2fe';
                drawCanvasRoundRect(ctx, 310, topY + 32, 230, 46, 14);
                ctx.fill();
                ctx.fillStyle = '#0369a1';
                ctx.font = '700 22px Inter, sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText(diffLabel, 425, topY + 56);

                ctx.fillStyle = '#dcfce7';
                drawCanvasRoundRect(ctx, PDF_CANVAS_W - 335, topY + 32, 225, 46, 14);
                ctx.fill();
                ctx.fillStyle = '#15803d';
                ctx.font = '700 22px Inter, sans-serif';
                ctx.fillText('✓ 100% Correcta', PDF_CANVAS_W - 222, topY + 56);

                ctx.strokeStyle = '#e2e8f0';
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.moveTo(105, topY + 100);
                ctx.lineTo(PDF_CANVAS_W - 105, topY + 100);
                ctx.stroke();

                const imgBoxX = 110;
                const imgBoxY = topY + 150;
                const imgBoxW = 540;
                const imgBoxH = 465;

                ctx.fillStyle = '#ffffff';
                drawCanvasRoundRect(ctx, imgBoxX, imgBoxY, imgBoxW, imgBoxH, 18);
                ctx.fill();
                ctx.strokeStyle = '#cbd5e1';
                ctx.lineWidth = 2;
                ctx.stroke();

                if (entry.thumbnail) {
                    try {
                        const img = await loadImageAsync(entry.thumbnail);
                        ctx.drawImage(img, imgBoxX + 12, imgBoxY + 12, imgBoxW - 24, imgBoxH - 24);
                    } catch (_) {}
                }

                ctx.textAlign = 'center';
                ctx.fillStyle = '#475569';
                ctx.font = '700 22px Inter, sans-serif';
                ctx.fillText('Perspectiva Isométrica 3D', imgBoxX + imgBoxW / 2, imgBoxY + imgBoxH + 36);

                const counts = countPieces(entry.item.grid);
                const statsText = counts.ramps > 0
                    ? `${counts.cubes} cubos · ${counts.ramps} rampas`
                    : `${counts.cubes} cubos`;
                ctx.fillStyle = '#64748b';
                ctx.font = '500 21px Inter, sans-serif';
                ctx.fillText(statsText, imgBoxX + imgBoxW / 2, imgBoxY + imgBoxH + 72);

                const viewSize = 350;
                const viewsBaseX = 720;
                const viewsGapX = 65;
                const viewsTopY = topY + 165;
                const viewsBotY = topY + 575;

                drawViewOnCanvas(ctx, entry.item.drawings?.alzado, viewsBaseX, viewsTopY, viewSize, 'ALZADO (+Z)', '#2563eb');
                drawViewOnCanvas(ctx, entry.item.drawings?.perfil, viewsBaseX + viewSize + viewsGapX, viewsTopY, viewSize, 'PERFIL IZQ. (-X)', '#d97706');
                drawViewOnCanvas(ctx, entry.item.drawings?.planta, viewsBaseX, viewsBotY, viewSize, 'PLANTA (+Y)', '#059669');

                const legX = viewsBaseX + viewSize + viewsGapX;
                const legY = viewsBotY;
                ctx.fillStyle = 'rgba(248, 250, 252, 0.9)';
                drawCanvasRoundRect(ctx, legX, legY, viewSize, viewSize, 14);
                ctx.fill();
                ctx.strokeStyle = '#cbd5e1';
                ctx.lineWidth = 2;
                ctx.stroke();

                ctx.textAlign = 'left';
                ctx.fillStyle = '#334155';
                ctx.font = '700 22px Inter, sans-serif';
                ctx.fillText('Sistema Europeo', legX + 28, legY + 58);

                ctx.strokeStyle = '#0f172a';
                ctx.lineWidth = 5;
                ctx.setLineDash([]);
                ctx.beginPath();
                ctx.moveTo(legX + 28, legY + 130);
                ctx.lineTo(legX + 100, legY + 130);
                ctx.stroke();
                ctx.fillStyle = '#475569';
                ctx.font = '500 20px Inter, sans-serif';
                ctx.fillText('Arista visible', legX + 116, legY + 132);

                ctx.strokeStyle = '#334155';
                ctx.lineWidth = 4;
                ctx.setLineDash([10, 7]);
                ctx.beginPath();
                ctx.moveTo(legX + 28, legY + 190);
                ctx.lineTo(legX + 100, legY + 190);
                ctx.stroke();
                ctx.setLineDash([]);
                ctx.fillText('Arista oculta', legX + 116, legY + 192);

                if (entry.item.solvedAt) {
                    const d = new Date(entry.item.solvedAt);
                    ctx.fillStyle = '#64748b';
                    ctx.font = '500 18px Inter, sans-serif';
                    ctx.fillText(`Resuelta: ${d.toLocaleDateString('es-ES')}`, legX + 28, legY + 292);
                }
            }

            return canvas.toDataURL('image/jpeg', 0.91);
        }

        /**
         * Genera y descarga el PDF oficial o de avance completamente rasterizado.
         */
        async function generateEvaluationPDF(isOfficial) {
            try {
                if (!window.jspdf || !window.jspdf.jsPDF) {
                    showToast('La librería PDF no se ha cargado correctamente.');
                    return;
                }

                const lvl = ensureEvalLevelInitialized(state.evalLevel);
                const levelLabel = EVAL_BLUEPRINTS[state.evalLevel].label;
                const solvedEntries = [];

                lvl.sequence.forEach((item, idx) => {
                    if (item.solved) {
                        const thumb = item.thumbnail || captureIsometricThumbnail(item.grid);
                        item.thumbnail = thumb;
                        solvedEntries.push({ index: idx, item, thumbnail: thumb });
                    }
                });

                const solvedCount = solvedEntries.length;
                if (isOfficial && solvedCount < 10) {
                    showToast('Debes completar las 10 figuras para descargar el Diploma Oficial.');
                    return;
                }

                showToast('Generando PDF rasterizado...');

                const { jsPDF } = window.jspdf;
                const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
                const now = new Date();
                const dateStr = now.toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric' });
                const verificationCode = `VD3D-${state.evalLevel.slice(0, 3).toUpperCase()}-${solvedCount}DE10-${now.getTime().toString(36).slice(-5).toUpperCase()}`;

                const coverUrl = renderDiplomaCoverCanvas({
                    isOfficial,
                    userName: state.userName || 'Alumno',
                    levelLabel,
                    solvedCount,
                    totalCount: 10,
                    dateStr,
                    verificationCode
                });
                doc.addImage(coverUrl, 'JPEG', 0, 0, 210, 297);

                const annexPages = Math.ceil(solvedEntries.length / 2);
                const totalPages = 1 + annexPages;

                for (let p = 0; p < annexPages; p++) {
                    const pair = solvedEntries.slice(p * 2, p * 2 + 2);
                    const pageUrl = await renderSolvedFiguresPageCanvas({
                        items: pair,
                        pageNum: p + 2,
                        totalPages,
                        userName: state.userName || 'Alumno',
                        levelLabel
                    });
                    doc.addPage();
                    doc.addImage(pageUrl, 'JPEG', 0, 0, 210, 297);
                }

                const safeName = (state.userName || 'Alumno')
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '')
                    .replace(/[^a-zA-Z0-9]+/g, '_')
                    .replace(/^_|_$/g, '');
                const prefix = isOfficial ? 'Diploma_Oficial' : 'Diploma_Avance';
                doc.save(`${prefix}_${levelLabel}_${safeName}.pdf`);
                showToast('PDF descargado correctamente');
            } catch (err) {
                console.error('Error al generar el PDF:', err);
                showToast('No se pudo generar el PDF.');
            }
        }

        function setMobileView(viewMode) {
            state.mobileView = viewMode;
            const mainEl = document.getElementById('main-workspace');
            const panel3D = document.getElementById('panel-3d');
            const panelDraw = document.getElementById('panel-draw');

            panel3D.classList.toggle('hidden', viewMode === 'draw');
            panel3D.classList.toggle('lg:flex', viewMode === 'draw');
            panelDraw.classList.toggle('hidden', viewMode === '3d');
            panelDraw.classList.toggle('lg:flex', viewMode === '3d');

            mainEl.classList.toggle('grid-rows-[minmax(0,42%)_minmax(0,58%)]', viewMode === 'both');
            mainEl.classList.toggle('grid-rows-1', viewMode !== 'both');

            document.querySelectorAll('.mobile-view-btn').forEach(btn => {
                const active = btn.dataset.mobileView === viewMode;
                btn.classList.toggle('bg-slate-900', active);
                btn.classList.toggle('text-white', active);
                btn.classList.toggle('bg-slate-100', !active);
                btn.classList.toggle('text-slate-600', !active);
            });
        }

        /* =========================================================================
         * ENLACE DE EVENTOS DE INTERFAZ Y ARRANQUE
         * ========================================================================= */
        function bindUIEvents() {
            document.getElementById('login-form').addEventListener('submit', (e) => {
                e.preventDefault();
                const input = document.getElementById('student-name-input');
                const name = input.value.trim();
                if (name.length < 2) {
                    document.getElementById('login-error').classList.remove('hidden');
                    input.focus();
                    return;
                }
                document.getElementById('login-error').classList.add('hidden');
                restoreUserSession(name);
                showToast(`¡Bienvenido/a, ${name}!`);
            });

            document.getElementById('btn-logout').addEventListener('click', () => {
                openConfirmModal(
                    'Cerrar sesión de alumno',
                    `¿Quieres cerrar la sesión de "${state.userName}"? Tu avance quedará guardado localmente en este dispositivo por si vuelves a entrar con el mismo nombre.`,
                    'Cerrar sesión',
                    () => logoutUser()
                );
            });

            document.getElementById('confirm-cancel').addEventListener('click', closeConfirmModal);
            document.getElementById('confirm-ok').addEventListener('click', () => {
                const cb = confirmCallback;
                closeConfirmModal();
                if (cb) cb();
            });

            document.getElementById('btn-congrats-pdf').addEventListener('click', () => generateEvaluationPDF(true));
            document.getElementById('btn-congrats-close').addEventListener('click', () => {
                document.getElementById('congrats-modal').classList.add('hidden');
            });

            document.getElementById('tab-practice').addEventListener('click', () => {
                if (state.mode !== 'practice') switchMode('practice');
            });
            document.getElementById('tab-eval').addEventListener('click', () => {
                if (state.mode !== 'eval') switchMode('eval');
            });

            document.getElementById('practice-diff-select').addEventListener('change', (e) => {
                state.practiceDifficulty = e.target.value;
                startPracticeFigure();
                saveStateToStorage();
                showToast(`Nivel de práctica: ${DIFFICULTY_META[state.practiceDifficulty].label}`);
            });

            document.getElementById('btn-new-figure').addEventListener('click', () => {
                startPracticeFigure();
                showToast(`Nueva figura (${DIFFICULTY_META[state.practiceDifficulty].label})`);
            });

            document.getElementById('btn-check-practice').addEventListener('click', checkDrawing);
            document.getElementById('btn-solution').addEventListener('click', toggleSolution);

            document.querySelectorAll('.eval-tab').forEach(btn => {
                btn.addEventListener('click', () => {
                    const nextLevel = btn.dataset.evalLevel;
                    if (nextLevel === state.evalLevel) return;
                    saveStateToStorage();
                    state.evalLevel = nextLevel;
                    loadCurrentEvalFigure();
                    saveStateToStorage();
                });
            });

            document.getElementById('btn-check-eval').addEventListener('click', checkDrawing);
            document.getElementById('btn-next-eval').addEventListener('click', advanceEvalStep);
            document.getElementById('btn-pdf-progress').addEventListener('click', () => generateEvaluationPDF(false));
            document.getElementById('btn-pdf-official').addEventListener('click', () => generateEvaluationPDF(true));

            document.getElementById('btn-reset-eval').addEventListener('click', () => {
                const label = EVAL_BLUEPRINTS[state.evalLevel].label;
                openConfirmModal(
                    `Reiniciar nivel ${label}`,
                    `Se borrará tu avance actual en el nivel ${label} y se generarán 10 figuras aleatorias nuevas. ¿Deseas continuar?`,
                    'Sí, reiniciar',
                    () => {
                        state.evalData[state.evalLevel] = null;
                        loadCurrentEvalFigure();
                        saveStateToStorage();
                        showToast(`Nivel ${label} reiniciado`);
                    }
                );
            });

            document.querySelectorAll('.mobile-view-btn').forEach(btn => {
                btn.addEventListener('click', () => setMobileView(btn.dataset.mobileView));
            });

            document.querySelectorAll('.tool-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    state.tool = btn.dataset.tool;
                });
            });

            document.querySelectorAll('.cam-btn').forEach(btn => {
                btn.addEventListener('click', () => animateCameraTo(btn.dataset.cam));
            });

            document.getElementById('btn-unit-grid').addEventListener('click', (e) => {
                state.showUnitGrid = !state.showUnitGrid;
                if (unitGridLines) unitGridLines.visible = state.showUnitGrid;
                const btn = e.currentTarget;
                btn.classList.toggle('bg-blue-50', state.showUnitGrid);
                btn.classList.toggle('border-blue-300', state.showUnitGrid);
                btn.classList.toggle('text-blue-700', state.showUnitGrid);
            });

            document.getElementById('btn-undo').addEventListener('click', undo);
            document.getElementById('btn-clear').addEventListener('click', clearAllDrawings);
            document.getElementById('btn-clear-check').addEventListener('click', clearCheckOverlay);

            window.addEventListener('keydown', (e) => {
                if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z') {
                    e.preventDefault();
                    undo();
                }
            });
        }

        window.onload = function () {
            try {
                buildDrawingGrids();
                init3D();
                bindUIEvents();
                animateLoop();

                const root = loadStorageRoot();
                if (root.activeUser) {
                    restoreUserSession(root.activeUser);
                } else {
                    startPracticeFigure();
                    document.getElementById('login-modal').classList.remove('hidden');
                    setTimeout(() => document.getElementById('student-name-input').focus(), 100);
                }
            } catch (err) {
                console.error('Error al inicializar:', err);
                showToast('Error al inicializar la aplicación 3D');
            }
        };
    </script>
