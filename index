    <script type="module">
        import * as THREE from 'three';
        import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

        /**
         * =========================================================================
         * CONSTANTES DE CONFIGURACIÓN, NIVELES Y PERSISTENCIA
         * =========================================================================
         */
        const STORAGE_KEY = 'diedricas3d_edu_v2';
        const GRID_SIZE = 3;
        const VIEWS = ['alzado', 'perfil', 'planta'];
        const PAD = 24;
        const CELL = 64;
        const TOTAL = PAD * 2 + CELL * GRID_SIZE; // 240

        const DIFFICULTY_META = {
            muy_facil:   { label: 'Muy fácil',   minBlocks: 5,  maxBlocks: 9,  minRamps: 0, maxRamps: 0, maxDashed: 2,  minDashed: 0, allowWedges: false, allowOverhang: false, minDiags: 0 },
            facil:       { label: 'Fácil',       minBlocks: 8,  maxBlocks: 12, minRamps: 0, maxRamps: 1, maxDashed: 6,  minDashed: 0, allowWedges: false, allowOverhang: false, minDiags: 0 },
            medio:       { label: 'Medio',       minBlocks: 10, maxBlocks: 15, minRamps: 1, maxRamps: 3, maxDashed: 14, minDashed: 2, allowWedges: true,  allowOverhang: true,  minDiags: 1 },
            dificil:     { label: 'Difícil',     minBlocks: 12, maxBlocks: 18, minRamps: 2, maxRamps: 4, maxDashed: 24, minDashed: 4, allowWedges: true,  allowOverhang: true,  minDiags: 2 },
            muy_dificil: { label: 'Muy difícil', minBlocks: 13, maxBlocks: 20, minRamps: 3, maxRamps: 6, maxDashed: 40, minDashed: 6, allowWedges: true,  allowOverhang: true,  minDiags: 3 }
        };

        // Secuencias incrementales exactas de 10 figuras por nivel de evaluación
        const EVAL_BLUEPRINTS = {
            basico: {
                label: 'Básico',
                steps: [
                    'muy_facil', 'muy_facil', 'muy_facil', 'muy_facil',
                    'facil', 'facil', 'facil', 'facil', 'facil', 'facil'
                ]
            },
            intermedio: {
                label: 'Intermedio',
                steps: [
                    'facil', 'facil',
                    'medio', 'medio', 'medio', 'medio', 'medio', 'medio',
                    'dificil', 'dificil'
                ]
            },
            avanzado: {
                label: 'Avanzado',
                steps: [
                    'medio', 'medio',
                    'dificil', 'dificil', 'dificil', 'dificil',
                    'muy_dificil', 'muy_dificil', 'muy_dificil', 'muy_dificil'
                ]
            }
        };

        /**
         * =========================================================================
         * ESTADO GLOBAL DE LA APLICACIÓN
         * =========================================================================
         */
        const state = {
            userName: null,
            mode: 'practice',                  // 'practice' | 'eval'
            practiceDifficulty: 'medio',
            evalLevel: 'basico',
            evalData: {
                basico: null,
                intermedio: null,
                avanzado: null
            },
            // Figura actualmente cargada en pantalla
            grid: createEmptyGrid(),
            meshData: null,
            solution: null,
            cubeCount: 0,
            rampCount: 0,
            // Herramientas y dibujo
            tool: 'solid',                     // 'solid' | 'dashed' | 'eraser'
            showUnitGrid: false,
            drawings: createEmptyDrawings(),
            history: [],
            checkActive: false,
            showSolution: false,
            mobileView: 'both'                 // 'both' | '3d' | 'draw'
        };

        // Variables Three.js (sin sombras)
        let scene, camera, renderer, controls, figureGroup, unitGridLines = null;
        let cameraAnim = null;

        // Referencias SVG
        const svgRefs = {};

        /* =========================================================================
         * UTILIDADES GENERALES Y TOAST / MODALES
         * ========================================================================= */
        function createEmptyGrid() {
            return Array.from({ length: GRID_SIZE }, () =>
                Array.from({ length: GRID_SIZE }, () => Array(GRID_SIZE).fill(null))
            );
        }

        function createEmptyDrawings() {
            return { alzado: {}, perfil: {}, planta: {} };
        }

        function cloneDrawings(d) {
            return {
                alzado: { ...(d?.alzado || {}) },
                perfil: { ...(d?.perfil || {}) },
                planta: { ...(d?.planta || {}) }
            };
        }

        function countPieces(grid) {
            let cubes = 0, ramps = 0;
            for (let x = 0; x < GRID_SIZE; x++) {
                for (let y = 0; y < GRID_SIZE; y++) {
                    for (let z = 0; z < GRID_SIZE; z++) {
                        const t = grid[x][y][z];
                        if (t === 'cube') cubes++;
                        else if (t) ramps++;
                    }
                }
            }
            return { cubes, ramps };
        }

        let toastTimer = null;
        function showToast(msg) {
            const el = document.getElementById('toast');
            el.textContent = msg;
            el.classList.remove('opacity-0', 'translate-y-2');
            el.classList.add('opacity-100', 'translate-y-0');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                el.classList.add('opacity-0', 'translate-y-2');
                el.classList.remove('opacity-100', 'translate-y-0');
            }, 2400);
        }

        // Modal de confirmación personalizado (sin usar alert/confirm)
        let confirmCallback = null;
        function openConfirmModal(title, message, okLabel, onConfirm) {
